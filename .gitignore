upstream/
node_modules/
__pycache__/
dest/
.tsbuildinfo

# nix / direnv working state. flake.nix, flake.lock, nix/ and .envrc ARE
# tracked; what direnv and nix-build leave behind is not.
.direnv/
/result
/result-*

browser-probe/*.js
!browser-probe/shims/*.js
!browser-probe/entry*.ts

# vm2wasm: see vm2wasm/README.md for why each of these is excluded and how to
# reconstruct it. Every source delta is captured in vm2wasm/spike.patch.
vm2wasm/src/
vm2wasm/wasi-sdk-33/
vm2wasm/shims/
vm2wasm/*.wasm.gz

# submit/: the scripts are tracked; what a submission RUN leaves behind — the
# rendered pull-request body and the tracker-search transcript — is scratch and
# is regenerated on every run.
/.submit/
