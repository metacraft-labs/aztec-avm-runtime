upstream/
node_modules/
__pycache__/
dest/
.tsbuildinfo

# nix / direnv working state. flake.nix, flake.lock, nix/ and .envrc ARE
# tracked; what direnv and nix-build leave behind is not.
.direnv/
/result
/result-*

browser-probe/*.js
!browser-probe/shims/*.js
!browser-probe/entry*.ts

# vm2wasm: see vm2wasm/README.md for why each of these is excluded and how to
# reconstruct it. Every source delta is captured in vm2wasm/spike.patch.
vm2wasm/src/
vm2wasm/wasi-sdk-33/
vm2wasm/shims/
vm2wasm/*.wasm.gz

# submit/: the scripts are tracked; what a submission RUN leaves behind — the
# rendered pull-request body and the tracker-search transcript — is scratch and
# is regenerated on every run.
/.submit/

# ct-writer: the trace-format dependency is materialised out of the object store by
# verification/build_ct_writer_wasm.sh, and cargo puts its artefacts in target/. Neither is
# source; both are reconstructed by that script from the revision pins.json declares.
ct-writer/build-wasm-deps/
ct-writer/target/
browser/dist/

# browser/node_modules is a SYMLINK to ../orchestration/node_modules, not a directory, so the
# `node_modules/` rule above does not match it. The browser package declares no dependencies of its
# own — it packages the orchestration's — and sharing the installed tree by symlink is what keeps
# exactly one pinned @aztec nightly in this repository and exactly one install of nine hundred
# packages. `verification/lib_m27_browser.sh` recreates it if it is missing.
/browser/node_modules

# L4's browser bundle is a BUILD PRODUCT, rebuilt by verify_browser_replay_dd9_clean on every run
# precisely so a DD-9 claim is never made over a stale artifact.
/replay/dist-browser/

# `diffsim/node_modules` is a SYMLINK in a worktree that shares the primary checkout's install, so
# the `node_modules/` rule above — which matches directories — does not match it. Same reason as
# browser/node_modules directly above.
/diffsim/node_modules
/spike/node_modules
/orchestration/node_modules
/replay/node_modules

# SWEEP LOGS ARE NOT REPOSITORY CONTENT, AND ONE OF THEM MADE A CHECK RED.
# `scratchpad/campaign/aztec-residuals-sweep.log` was committed at 1.0 MB, and a sweep log quotes
# every line its checks print — including the pull-request-opening command M11's own check greps
# for. `verify_submission_is_a_manual_step`'s "exactly one file in this repository can open a pull
# request" therefore counted the LOG as a second one. The residuals sweep could not have seen it:
# the log was copied into the tree AFTER that sweep ran, which is how a check goes red for work
# that had already finished.
#
# (This comment deliberately does not spell that command. The same check would count this file too,
# which is "a citation is the opposite of a dependency" — the campaign's own rule — arriving inside
# the remedy for it. It was spelled here first, and the check said so on the next run.)
#
# Sweep logs live under ~/.cache; the summariser reads them there.
scratchpad/campaign/*sweep*.log
