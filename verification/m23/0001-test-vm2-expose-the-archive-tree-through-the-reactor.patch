@@ -617,6 +617,39 @@ WASM_EXPORT int32_t avm_merkle_db_revert_checkpoint(uint32_t handle)
     });
 }
 
+// ---------------------------------------------------------------------------
+// THE ARCHIVE. Two exports, not one.
+//
+// M22's Outstanding Tasks priced closing the archive blocker at "one reactor export"; driving a
+// chain needs TWO, and the second is the one a seal cannot do without. `update_archive` appends a
+// block header; but the NEXT header's `lastArchive` is a READ of the archive, so a module that can
+// only append gives a caller no way to anchor block N+1 against block N. The read is the reason
+// `sealBlock` refused, not the append.
+//
+// Both are on the ADAPTER and neither is on `LowLevelMerkleDBInterface`. The AVM does not read the
+// archive, so the interface's fourteen stay fourteen and every check that pins that number is
+// untouched; what moves is the reactor's export list, from forty-nine to fifty-one.
+//
+// args: msgpack [TreeSnapshots, FF] — the block's four-tree state reference and its header hash.
+// no result. Refuses, with WorldState::update_archive's own message, if the state reference is not
+// the world state's current one.
+WASM_EXPORT int32_t avm_merkle_db_update_archive(uint32_t handle, const uint8_t* args, uint32_t len)
+{
+    AVM_MERKLE_DB(handle)
+    return guarded([&] {
+        const auto [block_state_ref, block_header_hash] = unpack_args<std::tuple<TreeSnapshots, FF>>(args, len);
+        db->update_archive(block_state_ref, block_header_hash);
+        clear_result();
+    });
+}
+
+// result: msgpack AppendOnlyTreeSnapshot — the archive's root and its next available leaf index.
+WASM_EXPORT int32_t avm_merkle_db_get_archive_snapshot(uint32_t handle)
+{
+    AVM_MERKLE_DB(handle)
+    return guarded([&] { pack_result(db->get_archive_snapshot()); });
+}
+
 // result: msgpack uint32.
 WASM_EXPORT int32_t avm_merkle_db_get_checkpoint_id(uint32_t handle)
 {
diff --git a/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.cpp b/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.cpp
index 4251aa38282..34c524d593c 100644
--- a/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.cpp
+++ b/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.cpp
@@ -10,6 +10,12 @@ AppendOnlyTreeSnapshot to_avm_snapshot(const world_state::TreeSnapshot& snapshot
                                    .next_available_leaf_index = snapshot.next_available_leaf_index };
 }
 
+world_state::TreeSnapshot to_reference_snapshot(const AppendOnlyTreeSnapshot& snapshot)
+{
+    return world_state::TreeSnapshot{ .root = snapshot.root,
+                                      .next_available_leaf_index = snapshot.next_available_leaf_index };
+}
+
 } // namespace
 
 TreeSnapshots MemoryMerkleDB::get_tree_roots() const
@@ -23,4 +29,19 @@ TreeSnapshots MemoryMerkleDB::get_tree_roots() const
     };
 }
 
+void MemoryMerkleDB::update_archive(const TreeSnapshots& block_state_ref, const FF& block_header_hash)
+{
+    world_state::TreeRoots roots;
+    roots.l1_to_l2_message_tree = to_reference_snapshot(block_state_ref.l1_to_l2_message_tree);
+    roots.note_hash_tree = to_reference_snapshot(block_state_ref.note_hash_tree);
+    roots.nullifier_tree = to_reference_snapshot(block_state_ref.nullifier_tree);
+    roots.public_data_tree = to_reference_snapshot(block_state_ref.public_data_tree);
+    inner_.update_archive(roots, block_header_hash);
+}
+
+AppendOnlyTreeSnapshot MemoryMerkleDB::get_archive_snapshot() const
+{
+    return to_avm_snapshot(inner_.get_tree_roots().archive_tree);
+}
+
 } // namespace bb::avm2::simulation
diff --git a/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.hpp b/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.hpp
index 8391c70bf87..a34816bca6e 100644
--- a/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.hpp
+++ b/barretenberg/cpp/src/barretenberg/vm2/simulation/lib/memory_merkle_db.hpp
@@ -79,6 +79,24 @@ class MemoryMerkleDB final : public LowLevelMerkleDBInterface {
     }
     void pad_tree(MerkleTreeId tree_id, size_t num_leaves) override { inner_.pad_tree(tree_id, num_leaves); }
 
+    // ------------------------------------------------------------------------------------------
+    // BLOCK-LEVEL, AND DELIBERATELY NOT PART OF `LowLevelMerkleDBInterface`.
+    //
+    // The AVM never reads the archive: `MerkleTreeId::ARCHIVE` appears in vm2 only in a tree-name
+    // switch, and the AVM's own column-serialised `TreeSnapshots` carries four trees. So these two
+    // are non-virtual methods on the ADAPTER rather than additions to the interface, which is what
+    // WORLD-STATE.md Gap A (RI-53) says the archive is for: block production, not execution.
+    //
+    // `update_archive` takes the block's state reference in the AVM's own `TreeSnapshots`
+    // vocabulary rather than the reference DB's `world_state::TreeRoots`, because `TreeSnapshots`
+    // is the type that already crosses the wasm boundary (`MSGPACK_CAMEL_CASE_FIELDS`) and
+    // `TreeRoots` has no msgpack declaration at all. The archive field of the constructed
+    // `TreeRoots` is left at its default and never read: `state_reference_equals` compares the four
+    // StateReference trees and ignores the fifth, which is the whole reason it exists.
+    // ------------------------------------------------------------------------------------------
+    void update_archive(const TreeSnapshots& block_state_ref, const FF& block_header_hash);
+    AppendOnlyTreeSnapshot get_archive_snapshot() const;
+
     void create_checkpoint() override { inner_.create_checkpoint(); }
     void commit_checkpoint() override { inner_.commit_checkpoint(); }
     void revert_checkpoint() override { inner_.revert_checkpoint(); }
