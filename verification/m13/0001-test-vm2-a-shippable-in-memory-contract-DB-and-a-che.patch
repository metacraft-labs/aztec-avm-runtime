+// ---------------------------------------------------------------------------
+// Decoding published-event logs.
+//
+// THE FIELD LAYOUTS BELOW ARE THE TYPESCRIPT PUBLISHERS', not a convention invented here. Each is
+// annotated with the reader in `yarn-project/protocol-contracts/src/` that defines it, and both are
+// checked against those readers by execution rather than by reading: the M13 verification decodes
+// the same log bytes with `ContractClassPublishedEvent.fromLog` and
+// `ContractInstancePublishedEvent.fromLog` in Node and requires the two decodes to agree field for
+// field. A layout re-derived downstream is a layout that can drift away from upstream's silently,
+// which is why the agreement is measured rather than assumed.
+// ---------------------------------------------------------------------------
+
+ContractClass MemoryContractDB::decode_class_log(const ContractClassLog& log)
+{
+    // `class-registry/contract_class_published_event.ts`, `fromLog`: the tag is field 0 and the
+    // reader starts at field 1 —
+    //   [1] contractClassId  [2] version  [3] artifactHash  [4] privateFunctionsRoot
+    //   [5] packed bytecode length in BYTES, then ceil(len / 31) payload fields.
+    const auto& fields = log.fields.fields;
+    if (fields.size() < 6) {
+        throw std::runtime_error("contract class log is too short to decode");
+    }
+    size_t offset = 1;
+    const FF class_id = fields[offset++];
+    offset++; // version — read and discarded, exactly as the TypeScript reader does for the AVM's
+              // purposes; `toContractClassPublic` carries it but `ContractClass` has no such field.
+    const FF artifact_hash = fields[offset++];
+    const FF private_functions_root = fields[offset++];
+    const auto declared_length = static_cast<size_t>(static_cast<uint64_t>(fields[offset++]));
+
+    // Bound the declared length by what the log can actually carry, for the reason the TypeScript
+    // reader states: otherwise a malformed log declares a multi-megabyte length backed by a tiny
+    // payload and forces the allocation during early validation.
+    const size_t available_fields = fields.size() - offset;
+    const size_t max_length = available_fields * PAYLOAD_BYTES_PER_FIELD;
+    if (declared_length > max_length) {
+        throw std::runtime_error("contract class log declares more bytecode than it carries");
+    }
+
+    std::vector<uint8_t> packed_bytecode;
+    packed_bytecode.reserve(declared_length);
+    for (size_t i = 0; i < available_fields && packed_bytecode.size() < declared_length; ++i) {
+        const std::vector<uint8_t> f = to_buffer(fields[offset + i]);
+        // Skip the first byte of each field: the payload is 31 bytes wide.
+        for (size_t b = 1; b < f.size() && packed_bytecode.size() < declared_length; ++b) {
+            packed_bytecode.push_back(f[b]);
+        }
+    }
+
+    return ContractClass{
+        .id = class_id,
+        .artifact_hash = artifact_hash,
+        .private_functions_root = private_functions_root,
+        .packed_bytecode = std::move(packed_bytecode),
+    };
+}
+
+std::pair<AztecAddress, ContractInstance> MemoryContractDB::decode_instance_log(const PrivateLog& log)
+{
+    // `instance-registry/contract_instance_published_event.ts`, `fromLog`: the tag is field 0, the
+    // reader skips it (`log.toBuffer().subarray(32)`) and then reads, IN THIS ORDER —
+    //   [1] address  [2] version  [3] salt  [4] contractClassId  [5] initializationHash
+    //   [6] immutablesHash  [7..13] publicKeys  [14] deployer
+    //
+    // `PublicKeys`' own seven fields are, from its constructor: npkMHash, ivpkM.x, ivpkM.y,
+    // ovpkMHash, tpkMHash, mspkMHash, fbpkMHash — the same order as this module's
+    // `PublicKeys::to_fields()`.
+    //
+    // THIS IS NOT THE ORDER `FuzzerContractDB::from_logs` READS, and the difference is a defect
+    // there rather than a variant format. That decoder's own comment says the layout is
+    // "tag, version, contract address" and it takes the address from field 2 — which is the
+    // VERSION — then reads salt/classId/initializationHash from 3/4/5 and continues straight into
+    // the public keys, so it takes `immutablesHash` (field 6) as `npkMHash` and stops two fields
+    // short, leaving `mspkMHash` and `fbpkMHash` unset. Nothing catches it because the fuzzer
+    // publishes and consumes its own logs, so its encoder and decoder are wrong together. The
+    // agreement asserted here is against the TypeScript reader, which is the format's authority.
+    const auto& fields = log.fields;
+    if (fields.size() < 15) {
+        throw std::runtime_error("contract instance log is too short to decode");
+    }
+    size_t offset = 1;
+    const AztecAddress address = fields[offset++];
+    offset++; // version
+    const FF salt = fields[offset++];
+    const ContractClassId contract_class_id = fields[offset++];
+    const FF initialization_hash = fields[offset++];
+    const FF immutables_hash = fields[offset++];
+    const PublicKeys public_keys = {
+        .nullifier_key_hash = fields[offset++],
+        .incoming_viewing_key = { fields[offset], fields[offset + 1] },
+        .outgoing_viewing_key_hash = fields[offset + 2],
+        .tagging_key_hash = fields[offset + 3],
+        .message_signing_key_hash = fields[offset + 4],
+        .fallback_key_hash = fields[offset + 5],
+    };
+    offset += 6;
+    const AztecAddress deployer = fields[offset++];
+
+    return { address,
+             ContractInstance{
+                 .salt = salt,
+                 .deployer = deployer,
+                 .current_contract_class_id = contract_class_id,
+                 .original_contract_class_id = contract_class_id,
+                 .initialization_hash = initialization_hash,
+                 .immutables_hash = immutables_hash,
+                 .public_keys = public_keys,
+             } };
+}
+
+// ---------------------------------------------------------------------------
+// ContractDBInterface
+// ---------------------------------------------------------------------------
+
+std::optional<ContractInstance> MemoryContractDB::get_contract_instance(const AztecAddress& address) const
+{
+    auto it = contract_instances.find(address);
+    return it == contract_instances.end() ? std::nullopt : std::make_optional(it->second);
+}
+
+std::optional<ContractClass> MemoryContractDB::get_contract_class(const ContractClassId& class_id) const
+{
+    auto it = contract_classes.find(class_id);
+    if (it == contract_classes.end()) {
+        return std::nullopt;
+    }
+    const auto& klass = it->second;
+    return ContractClass{
+        .id = klass.id,
+        .artifact_hash = klass.artifact_hash,
+        .private_functions_root = klass.private_functions_root,
+        .packed_bytecode = klass.packed_bytecode,
+    };
+}
+
+std::optional<FF> MemoryContractDB::get_bytecode_commitment(const ContractClassId& class_id) const
+{
+    auto it = contract_classes.find(class_id);
+    return it == contract_classes.end() ? std::nullopt : std::make_optional(it->second.public_bytecode_commitment);
+}
+
+std::optional<std::string> MemoryContractDB::get_debug_function_name(const AztecAddress& address,
+                                                                     const FunctionSelector& selector) const
+{
+    auto it = debug_function_names.find(std::make_pair(address, selector));
+    return it == debug_function_names.end() ? std::nullopt : std::make_optional(it->second);
+}
+
+void MemoryContractDB::add_contracts(const ContractDeploymentData& contract_deployment_data)
+{
+    for (const auto& log : contract_deployment_data.contract_class_logs) {
+        ContractClass klass = decode_class_log(log);
+        // The commitment is COMPUTED from the bytecode rather than taken from the log, because the
+        // log does not carry one: `toContractClassPublicWithBytecodeCommitment` computes it on the
+        // TypeScript side too, with the same function this calls.
+        const FF commitment = compute_public_bytecode_commitment(klass.packed_bytecode);
+        contract_classes.insert_or_assign(klass.id,
+                                          ContractClassWithCommitment{
+                                              .id = klass.id,
+                                              .artifact_hash = klass.artifact_hash,
+                                              .private_functions_root = klass.private_functions_root,
+                                              .packed_bytecode = std::move(klass.packed_bytecode),
+                                              .public_bytecode_commitment = commitment,
+                                          });
+    }
+    for (const auto& log : contract_deployment_data.private_logs) {
+        auto [address, instance] = decode_instance_log(log);
+        contract_instances.insert_or_assign(address, instance);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Checkpoints.
+//
+// Copy on create, restore on revert, discard on commit — the same shape as
+// `world_state::MemoryMerkleDB`, and the ids are deliberately the same vocabulary so a coordinating
+// owner can compare them directly.
+//
+// An underflow THROWS. Both existing in-memory copies return silently, and a caller that has
+// committed one time too many then goes on believing it holds a checkpoint it does not: the next
+// revert unwinds the wrong level and the contract state and the tree state end up describing
+// different transactions. That is exactly the failure this store exists to make loud. The messages
+// are the TypeScript `PublicContractsDB`'s own.
+// ---------------------------------------------------------------------------
+
+void MemoryContractDB::create_checkpoint()
+{
+    checkpoints.push(Checkpoint{ .contract_classes = contract_classes,
+                                 .contract_instances = contract_instances,
+                                 .debug_function_names = debug_function_names });
+    checkpoint_ids.push(checkpoint_ids.top() + 1);
+}
+
+void MemoryContractDB::commit_checkpoint()
+{
+    if (checkpoints.empty()) {
+        throw std::runtime_error("No checkpoint to commit");
+    }
+    checkpoints.pop();
+    checkpoint_ids.pop();
+}
+
+void MemoryContractDB::revert_checkpoint()
+{
+    if (checkpoints.empty()) {
+        throw std::runtime_error("No checkpoint to revert");
+    }
+    contract_classes = std::move(checkpoints.top().contract_classes);
+    contract_instances = std::move(checkpoints.top().contract_instances);
+    debug_function_names = std::move(checkpoints.top().debug_function_names);
+    checkpoints.pop();
+    checkpoint_ids.pop();
+}
+
+// ---------------------------------------------------------------------------
+// Explicit registration
+// ---------------------------------------------------------------------------
+
+void MemoryContractDB::add_contract_class(const ContractClassWithCommitment& contract_class)
+{
+    contract_classes.insert_or_assign(contract_class.id, contract_class);
+}
+
+void MemoryContractDB::add_contract_instance(const AztecAddress& address, const ContractInstance& instance)
+{
+    contract_instances.insert_or_assign(address, instance);
+}
+
+void MemoryContractDB::add_debug_function_name(const AztecAddress& address,
+                                               const FunctionSelector& selector,
+                                               std::string name)
+{
+    debug_function_names.insert_or_assign(std::make_pair(address, selector), std::move(name));
+}
+
+void MemoryContractDB::add_debug_function_names(std::span<const DebugFunctionNameHint> hints)
+{
+    for (const auto& hint : hints) {
+        debug_function_names.insert_or_assign(std::make_pair(hint.address, hint.selector), hint.name);
+    }
+}
+
+} // namespace bb::avm2::simulation
