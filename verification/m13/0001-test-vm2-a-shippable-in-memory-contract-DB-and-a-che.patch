+#include "barretenberg/vm2/simulation/standalone/memory_contract_db.hpp"
+
+#include "barretenberg/vm2/common/aztec_types.hpp"
+#include "barretenberg/vm2/simulation/lib/contract_crypto.hpp"
+#include "barretenberg/vm2/simulation/lib/memory_merkle_db.hpp"
+#include "barretenberg/vm2/simulation/standalone/checkpoint_coordinator.hpp"
+
+#include <cstdint>
+#include <gtest/gtest.h>
+#include <stdexcept>
+#include <vector>
+
+namespace bb::avm2::simulation {
+namespace {
+
+ContractClassWithCommitment make_class(uint64_t seed)
+{
+    std::vector<uint8_t> bytecode;
+    bytecode.reserve(70);
+    for (uint8_t i = 0; i < 70; ++i) {
+        bytecode.push_back(static_cast<uint8_t>(i + seed));
+    }
+    const FF commitment = compute_public_bytecode_commitment(bytecode);
+    return ContractClassWithCommitment{ .id = FF(seed),
+                                        .artifact_hash = FF(seed + 1000),
+                                        .private_functions_root = FF(seed + 2000),
+                                        .packed_bytecode = bytecode,
+                                        .public_bytecode_commitment = commitment };
+}
+
+ContractInstance make_instance(uint64_t seed)
+{
+    return ContractInstance{ .salt = FF(seed + 10),
+                             .deployer = FF(seed + 11),
+                             .current_contract_class_id = FF(seed),
+                             .original_contract_class_id = FF(seed),
+                             .initialization_hash = FF(seed + 12),
+                             .immutables_hash = FF(seed + 13),
+                             .public_keys = PublicKeys{ .nullifier_key_hash = FF(seed + 14),
+                                                        .incoming_viewing_key = { FF(seed + 15), FF(seed + 16) },
+                                                        .outgoing_viewing_key_hash = FF(seed + 17),
+                                                        .tagging_key_hash = FF(seed + 18),
+                                                        .message_signing_key_hash = FF(seed + 19),
+                                                        .fallback_key_hash = FF(seed + 20) } };
+}
+
+// The inverse of the decoders, used only to build a log to decode. It is deliberately not part of
+// the store: upstream's stores decode published-event logs, the Noir protocol contracts emit them.
+ContractClassLog encode_class_log(const ContractClassWithCommitment& klass)
+{
+    std::vector<FF> fields{ FF(0), klass.id, FF(2), klass.artifact_hash, klass.private_functions_root,
+                            FF(static_cast<uint64_t>(klass.packed_bytecode.size())) };
+    for (size_t i = 0; i < klass.packed_bytecode.size(); i += 31) {
+        std::vector<uint8_t> be(32, 0);
+        for (size_t b = 0; b < 31 && i + b < klass.packed_bytecode.size(); ++b) {
+            be[1 + b] = klass.packed_bytecode[i + b];
+        }
+        fields.push_back(from_buffer<FF>(be));
+    }
+    return ContractClassLog{ .contract_address = 0,
+                             .fields = ContractClassLogFields{ .fields = fields },
+                             .emitted_length = static_cast<uint32_t>(fields.size()) };
+}
+
+PrivateLog encode_instance_log(const AztecAddress& address, const ContractInstance& instance)
+{
+    std::vector<FF> fields{ FF(0),
+                            address,
+                            FF(2),
+                            instance.salt,
+                            instance.current_contract_class_id,
+                            instance.initialization_hash,
+                            instance.immutables_hash };
+    for (const FF& k : instance.public_keys.to_fields()) {
+        fields.push_back(k);
+    }
+    fields.push_back(instance.deployer);
+    return PrivateLog{ .fields = fields, .emitted_length = static_cast<uint32_t>(fields.size()) };
+}
+
+TEST(MemoryContractDBTest, LookupsMissBeforeAnythingIsRegistered)
+{
+    MemoryContractDB db;
+    EXPECT_FALSE(db.get_contract_instance(FF(1)).has_value());
+    EXPECT_FALSE(db.get_contract_class(FF(1)).has_value());
+    EXPECT_FALSE(db.get_bytecode_commitment(FF(1)).has_value());
+    EXPECT_FALSE(db.get_debug_function_name(FF(1), FF(2)).has_value());
+}
+
+TEST(MemoryContractDBTest, ExplicitRegistrationServesAllFourGetters)
+{
+    MemoryContractDB db;
+    const auto klass = make_class(7);
+    const auto instance = make_instance(7);
+    db.add_contract_class(klass);
+    db.add_contract_instance(FF(99), instance);
+    db.add_debug_function_name(FF(99), FF(0x5e1), "Token::transfer_in_public");
+
+    ASSERT_TRUE(db.get_contract_class(klass.id).has_value());
+    EXPECT_EQ(db.get_contract_class(klass.id)->packed_bytecode, klass.packed_bytecode);
+    EXPECT_EQ(db.get_bytecode_commitment(klass.id), klass.public_bytecode_commitment);
+    EXPECT_EQ(db.get_contract_instance(FF(99)), instance);
+    EXPECT_EQ(db.get_debug_function_name(FF(99), FF(0x5e1)), "Token::transfer_in_public");
+    // A different selector at the same address is a different key.
+    EXPECT_FALSE(db.get_debug_function_name(FF(99), FF(0x5e2)).has_value());
+}
+
+TEST(MemoryContractDBTest, DebugNamesArriveAsUpstreamHints)
+{
+    MemoryContractDB db;
+    const std::vector<DebugFunctionNameHint> hints = {
+        DebugFunctionNameHint{ .address = FF(1), .selector = FF(2), .name = "AMM::_swap" },
+        DebugFunctionNameHint{ .address = FF(1), .selector = FF(3), .name = "AMM::_add_liquidity" },
+    };
+    db.add_debug_function_names(hints);
+    EXPECT_EQ(db.get_debug_function_name(FF(1), FF(2)), "AMM::_swap");
+    EXPECT_EQ(db.get_debug_function_name(FF(1), FF(3)), "AMM::_add_liquidity");
+    EXPECT_EQ(db.debug_function_name_count(), 2u);
+}
+
+TEST(MemoryContractDBTest, AddContractsDecodesPublishedEventLogs)
+{
+    MemoryContractDB db;
+    const auto klass = make_class(21);
+    const auto instance = make_instance(21);
+    const ContractDeploymentData deployment{ .contract_class_logs = { encode_class_log(klass) },
+                                             .private_logs = { encode_instance_log(FF(555), instance) } };
+    db.add_contracts(deployment);
+
+    ASSERT_TRUE(db.get_contract_class(klass.id).has_value());
+    EXPECT_EQ(db.get_contract_class(klass.id)->packed_bytecode, klass.packed_bytecode);
+    EXPECT_EQ(db.get_contract_class(klass.id)->artifact_hash, klass.artifact_hash);
+    EXPECT_EQ(db.get_contract_class(klass.id)->private_functions_root, klass.private_functions_root);
+    // The commitment is computed from the decoded bytecode, and must equal the one computed from
+    // the original: every field of the instance survives the round trip, including the two the
+    // fuzzer's decoder drops.
+    EXPECT_EQ(db.get_bytecode_commitment(klass.id), klass.public_bytecode_commitment);
+    ASSERT_TRUE(db.get_contract_instance(FF(555)).has_value());
+    EXPECT_EQ(*db.get_contract_instance(FF(555)), instance);
+}
+
+TEST(MemoryContractDBTest, AddContractsAndExplicitRegistrationAgree)
+{
+    const auto klass = make_class(33);
+    const auto instance = make_instance(33);
+
+    MemoryContractDB registered;
+    registered.add_contract_class(klass);
+    registered.add_contract_instance(FF(777), instance);
+
+    MemoryContractDB observed;
+    observed.add_contracts(ContractDeploymentData{ .contract_class_logs = { encode_class_log(klass) },
+                                                   .private_logs = { encode_instance_log(FF(777), instance) } });
+
+    EXPECT_EQ(registered.get_contract_class(klass.id), observed.get_contract_class(klass.id));
+    EXPECT_EQ(registered.get_bytecode_commitment(klass.id), observed.get_bytecode_commitment(klass.id));
+    EXPECT_EQ(registered.get_contract_instance(FF(777)), observed.get_contract_instance(FF(777)));
+}
+
+TEST(MemoryContractDBTest, RevertUndoesRegistrationsAndCommitKeepsThem)
+{
+    MemoryContractDB db;
+    db.add_contract_class(make_class(1));
+    ASSERT_EQ(db.contract_class_count(), 1u);
+
+    db.create_checkpoint();
+    db.add_contract_class(make_class(2));
+    EXPECT_EQ(db.contract_class_count(), 2u);
+    db.revert_checkpoint();
+    EXPECT_EQ(db.contract_class_count(), 1u);
+    EXPECT_FALSE(db.get_contract_class(FF(2)).has_value());
+
+    db.create_checkpoint();
+    db.add_contract_class(make_class(3));
+    db.commit_checkpoint();
+    EXPECT_EQ(db.contract_class_count(), 2u);
+    EXPECT_TRUE(db.get_contract_class(FF(3)).has_value());
+}
+
+TEST(MemoryContractDBTest, CheckpointIdsFollowTheMerkleDbVocabulary)
+{
+    MemoryContractDB db;
+    EXPECT_EQ(db.get_checkpoint_id(), 0u);
+    db.create_checkpoint();
+    EXPECT_EQ(db.get_checkpoint_id(), 1u);
+    db.create_checkpoint();
+    EXPECT_EQ(db.get_checkpoint_id(), 2u);
+    db.revert_checkpoint();
+    EXPECT_EQ(db.get_checkpoint_id(), 1u);
+    db.commit_checkpoint();
+    EXPECT_EQ(db.get_checkpoint_id(), 0u);
+    EXPECT_EQ(db.checkpoint_depth(), 0u);
+}
+
+// The behaviour that turns an unbalanced sequence into an error instead of a wrong state. Both
+// existing in-memory copies return silently here.
+TEST(MemoryContractDBTest, UnderflowThrowsRatherThanSilentlyDoingNothing)
+{
+    MemoryContractDB db;
+    EXPECT_THROW(db.commit_checkpoint(), std::runtime_error);
+    EXPECT_THROW(db.revert_checkpoint(), std::runtime_error);
+    db.create_checkpoint();
+    db.commit_checkpoint();
+    EXPECT_THROW(db.commit_checkpoint(), std::runtime_error);
+}
+
+TEST(CheckpointCoordinatorTest, DrivesBothStacksAndReportsThemEqual)
+{
+    MemoryContractDB contract_db;
+    MemoryMerkleDB merkle_db;
+    CheckpointCoordinator coord(contract_db, merkle_db);
+
+    EXPECT_TRUE(coord.in_lockstep());
+    coord.create_checkpoint();
+    EXPECT_EQ(coord.depth(), 1u);
+    EXPECT_EQ(coord.contract_checkpoint_id(), 1u);
+    EXPECT_EQ(coord.merkle_checkpoint_id(), 1u);
+    coord.create_checkpoint();
+    EXPECT_EQ(coord.depth(), 2u);
+    coord.revert_checkpoint();
+    coord.commit_checkpoint();
+    EXPECT_EQ(coord.depth(), 0u);
+    EXPECT_TRUE(coord.in_lockstep());
+}
+
+TEST(CheckpointCoordinatorTest, DetectsADesynchronisationInjectedBehindItsBack)
+{
+    MemoryContractDB contract_db;
+    MemoryMerkleDB merkle_db;
+    CheckpointCoordinator coord(contract_db, merkle_db);
+    coord.create_checkpoint();
+
+    // The injection: the merkle stack is moved directly, exactly as a host calling the per-DB
+    // export would move it.
+    merkle_db.create_checkpoint();
+    EXPECT_FALSE(coord.in_lockstep());
+    EXPECT_THROW(coord.assert_lockstep(), std::runtime_error);
+    // And the next coordinated operation refuses rather than unwinding the wrong level.
+    EXPECT_THROW(coord.revert_checkpoint(), std::runtime_error);
+
+    // The other side, and the message must name the other side.
+    MemoryContractDB contract_db2;
+    MemoryMerkleDB merkle_db2;
+    CheckpointCoordinator coord2(contract_db2, merkle_db2);
+    coord2.create_checkpoint();
+    contract_db2.create_checkpoint();
+    try {
+        coord2.assert_lockstep();
+        FAIL() << "an injected contract-side desynchronisation was not detected";
+    } catch (const std::runtime_error& e) {
+        EXPECT_NE(std::string(e.what()).find("CONTRACT db stack"), std::string::npos);
+    }
+}
+
+TEST(CheckpointCoordinatorTest, RefusesToUnderflowEitherStack)
+{
+    MemoryContractDB contract_db;
+    MemoryMerkleDB merkle_db;
+    CheckpointCoordinator coord(contract_db, merkle_db);
+    // MemoryMerkleDB pops its stack unguarded, so this guard is what stands between a host and
+    // undefined behaviour there.
+    EXPECT_THROW(coord.commit_checkpoint(), std::runtime_error);
+    EXPECT_THROW(coord.revert_checkpoint(), std::runtime_error);
+    EXPECT_EQ(coord.depth(), 0u);
+}
+
+TEST(CheckpointCoordinatorTest, TheContractDbItHandsOutIsTheDecorator)
+{
+    MemoryContractDB contract_db;
+    MemoryMerkleDB merkle_db;
+    CheckpointCoordinator coord(contract_db, merkle_db);
+    // Not the store: the PureContractDB decorator over it, so a consumer inherits whatever that
+    // decorator does today and whatever it grows to do.
+    EXPECT_NE(static_cast<ContractDBInterface*>(&contract_db), &coord.contract_db());
+    contract_db.add_contract_class(make_class(5));
+    EXPECT_TRUE(coord.contract_db().get_contract_class(FF(5)).has_value());
+}
