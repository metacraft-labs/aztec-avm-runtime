+#include "barretenberg/vm2/simulation/standalone/checkpoint_coordinator.hpp"
+
+#include <stdexcept>
+#include <string>
+
+#include "barretenberg/common/log.hpp"
+
+namespace bb::avm2::simulation {
+
+std::string CheckpointCoordinator::lockstep_report() const
+{
+    return "coordinator=" + std::to_string(coordinated_depth) +
+           " contractDb=" + std::to_string(contract_checkpoint_id()) +
+           " merkleDb=" + std::to_string(merkle_checkpoint_id());
+}
+
+void CheckpointCoordinator::assert_lockstep() const
+{
+    if (in_lockstep()) {
+        return;
+    }
+    // Name the side rather than only the numbers: "they disagree" sends a reader to both stacks,
+    // and one of the two is always innocent.
+    const uint32_t contract_id = contract_checkpoint_id();
+    const uint32_t merkle_id = merkle_checkpoint_id();
+    std::string which;
+    if (contract_id != coordinated_depth && merkle_id != coordinated_depth) {
+        which = "both stacks moved outside the coordinator";
+    } else if (contract_id != coordinated_depth) {
+        which = "the CONTRACT db stack moved outside the coordinator";
+    } else {
+        which = "the MERKLE db stack moved outside the coordinator";
+    }
+    throw std::runtime_error("checkpoint stacks are not in lockstep: " + which + " (" + lockstep_report() + ")");
+}
+
+void CheckpointCoordinator::create_checkpoint()
+{
+    assert_lockstep();
+    decorated.create_checkpoint();
+    merkle.create_checkpoint();
+    ++coordinated_depth;
+    assert_lockstep();
+}
+
+void CheckpointCoordinator::commit_checkpoint()
+{
+    assert_lockstep();
+    if (coordinated_depth == 0) {
+        throw std::runtime_error("No checkpoint to commit");
+    }
+    decorated.commit_checkpoint();
+    merkle.commit_checkpoint();
+    --coordinated_depth;
+    assert_lockstep();
+}
+
+void CheckpointCoordinator::revert_checkpoint()
+{
+    assert_lockstep();
+    if (coordinated_depth == 0) {
+        throw std::runtime_error("No checkpoint to revert");
+    }
+    decorated.revert_checkpoint();
+    merkle.revert_checkpoint();
+    --coordinated_depth;
+    assert_lockstep();
+}
+
+} // namespace bb::avm2::simulation
