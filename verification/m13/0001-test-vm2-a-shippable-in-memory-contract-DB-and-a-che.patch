+
+// ===========================================================================
+// M13 -- the shippable contract DB, its two population paths, and the checkpoint coordinator.
+//
+// `contractdbinputs` prints, per corpus program, what a host needs to exercise all EIGHT
+// `ContractDBInterface` methods against `simulation::MemoryContractDB` inside `avm.wasm`, plus the
+// two things `TestContractDB` could not supply at all:
+//
+//   * a `ContractDeploymentData` carrying the program's own contract class and instance encoded as
+//     PUBLISHED-EVENT LOGS, so `add_contracts` has something real to decode. The encoder here is
+//     the inverse of the decoder in `MemoryContractDB`, and neither is the authority: the field
+//     layouts are the TypeScript publishers' and the M13 verification decodes these same log fields
+//     with upstream's own `ContractClassPublishedEvent.fromLog` and
+//     `ContractInstancePublishedEvent.fromLog` in Node and requires the two decodes to agree. The
+//     raw fields are therefore printed as well, not only the packed blob.
+//
+//   * a `DebugFunctionNameHint` vector and a fast-simulation input whose enqueued call carries the
+//     matching selector as `calldata[0]`, which is what `TxExecution::get_debug_function_name`
+//     reads. The tester computes the calldata hash itself, so the call is upstream-shaped rather
+//     than a struct edited after the fact.
+//
+// And `.fastdeploy` is the same input with a SECOND contract's deployment logs placed in
+// `revertible_contract_deployment_data`. `TxExecution::insert_revertibles` calls
+// `contract_db.add_contracts` with exactly that field, INSIDE the checkpoint it opens at the end of
+// setup -- so on a program that succeeds the contract survives the transaction, and on one that
+// reverts it must be gone along with the tree writes. That is the deploy/call/revert roundtrip, run
+// by upstream's own code rather than by a sequence this driver performs.
+// ---------------------------------------------------------------------------
+
+// The published-event ENCODERS. Ours, and only a driver's: upstream's stores decode these logs,
+// they never produce them (the Noir protocol contracts do). Written from the same two TypeScript
+// readers the decoder is written from, so a disagreement between them shows up as a decode failure
+// rather than as a silent field shift.
+ContractClassLog encode_class_log(const ContractClassWithCommitment& klass)
+{
+    // class-registry/contract_class_published_event.ts: [0] tag, [1] id, [2] version,
+    // [3] artifactHash, [4] privateFunctionsRoot, [5] byte length, then 31 payload bytes per field.
+    std::vector<FF> fields;
+    fields.push_back(FF(0));            // tag; the reader skips it
+    fields.push_back(klass.id);
+    fields.push_back(FF(2));            // version
+    fields.push_back(klass.artifact_hash);
+    fields.push_back(klass.private_functions_root);
+    fields.push_back(FF(static_cast<uint64_t>(klass.packed_bytecode.size())));
+    for (size_t i = 0; i < klass.packed_bytecode.size(); i += 31) {
+        // A field is 32 bytes big-endian and the payload occupies the LOW 31, so the top byte is
+        // zero and `to_buffer(...)[0]` -- the byte the reader drops -- is that zero.
+        std::vector<uint8_t> be(32, 0);
+        const size_t n = std::min<size_t>(31, klass.packed_bytecode.size() - i);
+        for (size_t b = 0; b < n; ++b) {
+            be[1 + b] = klass.packed_bytecode[i + b];
+        }
+        fields.push_back(from_buffer<FF>(be));
+    }
+    return ContractClassLog{ .contract_address = 0,
+                             .fields = ContractClassLogFields{ .fields = fields },
+                             .emitted_length = static_cast<uint32_t>(fields.size()) };
+}
+
+PrivateLog encode_instance_log(const AztecAddress& address, const ContractInstance& instance)
+{
+    // instance-registry/contract_instance_published_event.ts: [0] tag, [1] address, [2] version,
+    // [3] salt, [4] contractClassId, [5] initializationHash, [6] immutablesHash,
+    // [7..13] publicKeys, [14] deployer.
+    std::vector<FF> fields;
+    fields.push_back(FF(0)); // tag
+    fields.push_back(address);
+    fields.push_back(FF(2)); // version
+    fields.push_back(instance.salt);
+    fields.push_back(instance.current_contract_class_id);
+    fields.push_back(instance.initialization_hash);
+    fields.push_back(instance.immutables_hash);
+    for (const FF& k : instance.public_keys.to_fields()) {
+        fields.push_back(k);
+    }
+    fields.push_back(instance.deployer);
+    return PrivateLog{ .fields = fields, .emitted_length = static_cast<uint32_t>(fields.size()) };
+}
+
+void emit_fields(const std::string& key, const std::vector<FF>& fields)
+{
+    line(key + ".count", dec(static_cast<uint64_t>(fields.size())));
+    for (size_t i = 0; i < fields.size(); ++i) {
+        line(key + "." + dec(static_cast<uint64_t>(i)), hex(fields[i]));
+    }
+}
+
+// The debug function names, from a file the caller supplies: one name per line, in corpus order.
+//
+// THE NAMES ARE THE ARTIFACTS', NOT THIS DRIVER'S. The seven corpus programs are hand-assembled
+// bytecode and have no compiled artifact to take a name from, so the check feeds in real function
+// names derived from `fixtures/contracts/artifacts.json` — the six compiled Noir contracts the M2
+// corpus names — and then requires both the DB's answer and the AVM's own frame label to be exactly
+// those. Without the file the names fall back to `corpus::<program>`, so the driver is runnable on
+// its own; the check never uses the fallback.
+std::vector<std::string> read_debug_names(const std::string& path, size_t count)
+{
+    std::vector<std::string> names;
+    if (!path.empty()) {
+        std::ifstream in(path);
+        if (!in) {
+            std::cerr << "avm_differential: cannot read the debug-name file: " << path << "\n";
+            std::exit(2);
+        }
+        std::string l;
+        while (std::getline(in, l)) {
+            if (!l.empty()) {
+                names.push_back(l);
+            }
+        }
+        if (names.size() != count) {
+            std::cerr << "avm_differential: the debug-name file carries " << names.size() << " name(s), need "
+                      << count << "\n";
+            std::exit(2);
+        }
+    }
+    return names;
+}
+
+void mode_contract_db_inputs(const std::string& names_path)
+{
+    line("contractDbInputs.version", "1");
+    line("contractDbInputs.coverage", "seven-hand-assembled-corpus-programs-the-same-seven-M8-and-M12-compare");
+
+    const auto programs = corpus();
+    line("contractDbInputs.programs.count", dec(static_cast<uint64_t>(programs.size())));
+    const auto supplied_names = read_debug_names(names_path, programs.size());
+    line("contractDbInputs.debugNames.source", supplied_names.empty() ? "fallback" : names_path);
+
+    uint64_t index = 0;
+    for (const auto& [name, bytecode] : programs) {
+        const std::string p = "contractDbInputs." + name;
+        const FF selector = FF(0x51100000ULL + index);
+        const std::string function_name =
+            supplied_names.empty() ? ("corpus::" + name) : supplied_names[static_cast<size_t>(index)];
+        ++index;
+
+        PublicTxSimulationTester tester;
+        const auto contract = tester.deploy_contract(bytecode);
+
+        // A SECOND deployment of the same bytecode under a different salt: a different address and a
+        // different instance, sharing the class. This is the one that arrives through
+        // `add_contracts` during execution rather than through explicit registration.
+        //
+        // It is deployed on a SEPARATE tester, so it leaves no mark on the trees the transaction
+        // below runs against: `deploy_contract` derives the address from the salt, the class id and
+        // the deployer, none of which depend on tree state, and this contract is meant to arrive as
+        // a published-event log rather than as a pre-seeded deployment nullifier. Deploying it on
+        // the same tester silently added a second deployment nullifier that the reactor's seeding
+        // then replayed INSTEAD of the first one — every program halted exceptionally because the
+        // contract being called was no longer resolvable.
+        PublicTxSimulationTester deploy_tester;
+        const auto deployed = deploy_tester.deploy_contract(bytecode, /*salt=*/FF(0xd0ed));
+
+        const auto after_deploy = tester.merkle_db().get_tree_roots();
+        const index_t nullifier_index = static_cast<index_t>(after_deploy.nullifier_tree.next_available_leaf_index) - 1;
+        const auto deployment_nullifier = tester.merkle_db().get_leaf_preimage_nullifier_tree(nullifier_index).leaf;
+
+        auto hint_config = PublicTxSimulationTester::default_config();
+        hint_config.collect_hints = true;
+        hint_config.collect_public_inputs = true;
+        hint_config.collect_statistics = true;
+        // The selector as calldata[0]: `TxExecution::get_debug_function_name` reads exactly that,
+        // and an enqueued call with empty calldata never reaches the contract DB at all.
+        const auto hinted = tester.simulate_tx(
+            { TestEnqueuedCall{ .contract_address = contract.address, .calldata = { selector } } }, hint_config);
+        if (!hinted.hints.has_value()) {
+            std::cerr << "avm_differential: hint collection produced no hints for " << name << "\n";
+            std::exit(2);
+        }
+
+        const auto after_fund = tester.merkle_db().get_tree_roots();
+        const index_t public_data_index =
+            static_cast<index_t>(after_fund.public_data_tree.next_available_leaf_index) - 1;
+        const auto fee_juice_leaf = tester.merkle_db().get_leaf_preimage_public_data_tree(public_data_index).leaf;
+
+        line(p + ".address", hex(contract.address));
+        line(p + ".classId", hex(contract.contract_class.id));
+        line(p + ".commitment", hex(contract.contract_class.public_bytecode_commitment));
+        line(p + ".selector", hex(selector));
+        line(p + ".functionName", function_name);
+        // The second contract, field by field in plain hex. These are what the M13 check compares
+        // upstream's OWN TypeScript log decoders against, so the wire format is settled by two
+        // independent decoders agreeing on the same bytes rather than by this driver's encoder
+        // agreeing with the decoder written from the same page.
+        line(p + ".deployed.address", hex(deployed.address));
+        line(p + ".deployed.classId", hex(deployed.contract_class.id));
+        line(p + ".deployed.artifactHash", hex(deployed.contract_class.artifact_hash));
+        line(p + ".deployed.privateFunctionsRoot", hex(deployed.contract_class.private_functions_root));
+        line(p + ".deployed.bytecodeBytes", dec(static_cast<uint64_t>(deployed.contract_class.packed_bytecode.size())));
+        line(p + ".deployed.salt", hex(deployed.instance.salt));
+        line(p + ".deployed.deployer", hex(deployed.instance.deployer));
+        line(p + ".deployed.initializationHash", hex(deployed.instance.initialization_hash));
+        line(p + ".deployed.immutablesHash", hex(deployed.instance.immutables_hash));
+        {
+            const auto keys = deployed.instance.public_keys.to_fields();
+            for (size_t k = 0; k < keys.size(); ++k) {
+                line(p + ".deployed.publicKey." + dec(static_cast<uint64_t>(k)), hex(keys[k]));
+            }
+        }
+
+        // The four seeding calls M12 already uses, unchanged.
+        emit_blob(p + ".setup.class", contract.contract_class);
+        emit_blob(p + ".setup.instance", std::make_tuple(contract.address, contract.instance));
+        emit_blob(p + ".setup.nullifier", deployment_nullifier);
+        emit_blob(p + ".setup.publicdata", fee_juice_leaf);
+
+        // Debug names, as UPSTREAM'S OWN hint type.
+        const std::vector<DebugFunctionNameHint> names = {
+            DebugFunctionNameHint{ .address = contract.address, .selector = selector, .name = function_name }
+        };
+        emit_blob(p + ".setup.debugnames", names);
+
+        // The deployment logs, both packed and as raw fields for the cross-language decode.
+        const ContractClassLog class_log = encode_class_log(deployed.contract_class);
+        const PrivateLog instance_log = encode_instance_log(deployed.address, deployed.instance);
+        const ContractDeploymentData deployment{ .contract_class_logs = { class_log },
+                                                 .private_logs = { instance_log } };
+        emit_blob(p + ".args.deployment", deployment);
+        emit_fields(p + ".logs.class", class_log.fields.fields);
+        emit_fields(p + ".logs.instance", instance_log.fields);
+
+        // The same for the program's OWN contract, so `add_contracts` and explicit registration can
+        // be shown to populate the store identically.
+        const ContractDeploymentData self_deployment{
+            .contract_class_logs = { encode_class_log(contract.contract_class) },
+            .private_logs = { encode_instance_log(contract.address, contract.instance) }
+        };
+        emit_blob(p + ".args.selfDeployment", self_deployment);
+
+        AvmFastSimulationInputs fast{
+            .ws_revision = {},
+            .config = PublicTxSimulationTester::default_config(),
+            .tx = hinted.hints->tx,
+            .global_variables = hinted.hints->global_variables,
+            .protocol_contracts = hinted.hints->protocol_contracts,
+        };
+        fast.config.collect_statistics = true;
+        fast.config.collect_public_inputs = true;
+        emit_blob(p + ".fast", fast);
+
+        // The deploying variant. `revertible_contract_deployment_data` is the ONLY field that
+        // differs, and it is the field `insert_revertibles` hands to `add_contracts`.
+        AvmFastSimulationInputs fast_deploy = fast;
+        fast_deploy.tx.revertible_contract_deployment_data = deployment;
+        emit_blob(p + ".fastdeploy", fast_deploy);
+
+        // Per-program arguments for the exported lookups.
+        emit_blob(p + ".args.address", contract.address);
+        emit_blob(p + ".args.classId", contract.contract_class.id);
+        emit_blob(p + ".args.debugName", std::make_tuple(contract.address, selector));
+        emit_blob(p + ".args.deployedAddress", deployed.address);
+        emit_blob(p + ".args.deployedClassId", deployed.contract_class.id);
+        // An address and a class id NOBODY registers, so "found" is a discrimination rather than an
+        // observation: every getter must answer nullopt for these.
+        emit_blob(p + ".args.absentAddress", FF(0xabbe5e17ULL));
+        emit_blob(p + ".args.absentClassId", FF(0xabbe5e18ULL));
+        emit_blob(p + ".args.absentDebugName", std::make_tuple(contract.address, FF(0xabbe5e19ULL)));
+    }
+
+    emit_blob("contractDbInputs.args.emptyDeployment", ContractDeploymentData{});
+    // Two DISTINCT tree writes, for the arm that shows what a naive owner produces from an injected
+    // desynchronisation: one inside the injected level and one inside the level the owner opens, so
+    // an unwind to the wrong level is visible in the roots rather than merely in a counter.
+    emit_blob("contractDbInputs.args.appendOuter",
+              std::make_tuple(MerkleTreeId::NOTE_HASH_TREE, std::vector<FF>{ FF(0x13e50001) }));
+    emit_blob("contractDbInputs.args.appendInner",
+              std::make_tuple(MerkleTreeId::NOTE_HASH_TREE, std::vector<FF>{ FF(0x13e50002) }));
+    line("contractDbInputs.done", "1");
+}
+
 } // namespace
 
 int main(int argc, char** argv)
@@ -1061,6 +1335,10 @@ int main(int argc, char** argv)
         mode_reactor_inputs();
         return 0;
     }
+    if (mode == "contractdbinputs") {
+        mode_contract_db_inputs(argc >= 3 ? std::string(argv[2]) : std::string());
+        return 0;
+    }
     if (mode == "bench" || mode == "benchsteps") {
         if (argc < 4) {
             std::cerr << "usage: avm_differential " << mode << " <program> <reps>\n";
diff --git a/barretenberg/cpp/src/barretenberg/vm2/reactor/avm_reactor.cpp b/barretenberg/cpp/src/barretenberg/vm2/reactor/avm_reactor.cpp
index 3c290433133..c22b749e5cd 100644
--- a/barretenberg/cpp/src/barretenberg/vm2/reactor/avm_reactor.cpp
+++ b/barretenberg/cpp/src/barretenberg/vm2/reactor/avm_reactor.cpp
@@ -39,11 +39,28 @@
 // `simulate_fast_internal` satisfies it itself with `PureMerkleDB`, exactly as it wraps whatever
 // raw contract DB it is handed in `PureContractDB`.
 //
-// THE RAW CONTRACT DB IS PROVISIONAL AND M13 OWNS IT. `TestContractDB` from `vm2/testing/` is the
-// only in-memory raw `ContractDBInterface` upstream has; `PureContractDB` is a decorator over a
-// raw one and the shippable raw one is the native, IPC-backed `cdb`. Whether `TestContractDB`
-// ships, is upstreamed as an in-memory store beside `PureContractDB`, or is replaced is M13's
