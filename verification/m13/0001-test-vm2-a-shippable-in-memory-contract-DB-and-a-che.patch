--- /dev/null
+++ b/barretenberg/cpp/src/barretenberg/vm2/simulation/standalone/memory_contract_db.hpp
@@ -0,0 +1,113 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <stack>
+#include <string>
+#include <vector>
+
+#include "barretenberg/vm2/common/avm_io.hpp"
+#include "barretenberg/vm2/common/aztec_types.hpp"
+#include "barretenberg/vm2/common/map.hpp"
+#include "barretenberg/vm2/simulation/interfaces/db.hpp"
+#include "barretenberg/vm2/simulation/lib/db_types.hpp"
+
+namespace bb::avm2::simulation {
+
+/**
+ * @brief An in-memory raw ContractDBInterface, with no dependency outside this module.
+ *
+ * WHY THIS EXISTS. `PureContractDB`, in this same directory, is a DECORATOR: it holds a
+ * `ContractDBInterface&` and forwards to it. It is not a store, and `simulate_fast_internal`
+ * constructs one around whatever raw contract DB it is handed. The raw ones that exist are
+ * `HintedRawContractDB` (backed by a transaction's `ExecutionHints`, so it can only answer what a
+ * previous hint-collecting run already asked), `CdbIpcContractDB` (a transport adapter over a
+ * TypeScript `PublicContractsDB`, reached over a unix socket and linking `ipc_runtime`), and two
+ * near-identical copies of the same little map-backed store: `TestContractDB` in `vm2/testing/`
+ * and `FuzzerContractDB` in `avm_fuzzer/common/interfaces/`. So there is no in-memory raw contract
+ * DB outside `testing/` and the fuzzer that a consumer can POPULATE — with artifacts it already
+ * holds, or with the deployment logs execution produces — as opposed to replaying a previous run's
+ * hints or asking a peer over a socket. This is that one, and it lives beside the decorator that
+ * needs it, in the directory whose name records that it is deliberately dependency-free.
+ *
+ * WHAT IT ADDS OVER THE TWO EXISTING COPIES, and each of the three is a behaviour they get wrong
+ * rather than a feature they lack:
+ *
+ *   - `add_contracts` is IMPLEMENTED against the field layout the TypeScript publishers define.
+ *     `TestContractDB`'s is a no-op ("tests deploy directly"), so a transaction that publishes a
+ *     contract class and then calls into it cannot work against it at all.
+ *     `FuzzerContractDB`'s decodes an instance log with the wrong field order — see the note above
+ *     `decode_instance_log` — and drops two fields.
+ *   - `get_debug_function_name` answers from a registered map rather than returning `nullopt`
+ *     unconditionally, which both copies do. The names it serves are `DebugFunctionNameHint`s, the
+ *     type `ExecutionHints` already carries and `HintedRawContractDB` already consumes, so a
+ *     consumer that has hints and a consumer that registers names are populating the same store
+ *     with the same type.
+ *   - committing or reverting with no checkpoint open THROWS. Both existing copies silently do
+ *     nothing, which turns an unbalanced sequence into a plausible-looking wrong state instead of
+ *     an error. The TypeScript `PublicContractsDB` — the shippable store this is the in-memory
+ *     analogue of — throws in both cases, with those two messages.
+ *
+ * CHECKPOINT IDS. `get_checkpoint_id()` has the same semantics as
+ * `LowLevelMerkleDBInterface::get_checkpoint_id()`: a stack seeded with 0, and `parent + 1` pushed
+ * on create. It is deliberately identical so that a coordinating owner driving a contract DB and a
+ * merkle DB together can compare the two ids as an EQUALITY rather than inferring agreement from
+ * two different vocabularies. It is not on `ContractDBInterface` — adding a method there would
+ * oblige all eight implementations — so it is read from the concrete store.
+ */
+class MemoryContractDB final : public ContractDBInterface {
+  public:
+    MemoryContractDB() = default;
+
+    // --- ContractDBInterface ------------------------------------------------
+    std::optional<ContractInstance> get_contract_instance(const AztecAddress& address) const override;
+    std::optional<ContractClass> get_contract_class(const ContractClassId& class_id) const override;
+    std::optional<FF> get_bytecode_commitment(const ContractClassId& class_id) const override;
+    std::optional<std::string> get_debug_function_name(const AztecAddress& address,
+                                                       const FunctionSelector& selector) const override;
+
+    void add_contracts(const ContractDeploymentData& contract_deployment_data) override;
+
+    void create_checkpoint() override;
+    void commit_checkpoint() override;
+    void revert_checkpoint() override;
+
+    // --- Explicit registration ---------------------------------------------
+    //
+    // The other half of the deliverable: a consumer that already holds a compiled artifact
+    // registers it directly, rather than round-tripping it through a published-event log.
+    void add_contract_class(const ContractClassWithCommitment& contract_class);
+    void add_contract_instance(const AztecAddress& address, const ContractInstance& instance);
+    void add_debug_function_name(const AztecAddress& address, const FunctionSelector& selector, std::string name);
+    void add_debug_function_names(std::span<const DebugFunctionNameHint> hints);
+
+    // --- Observation --------------------------------------------------------
+    uint32_t get_checkpoint_id() const { return checkpoint_ids.top(); }
+    uint32_t checkpoint_depth() const { return static_cast<uint32_t>(checkpoints.size()); }
+    size_t contract_class_count() const { return contract_classes.size(); }
+    size_t contract_instance_count() const { return contract_instances.size(); }
+    size_t debug_function_name_count() const { return debug_function_names.size(); }
+
+    // The decoders, exposed so a consumer can decode a published-event log without owning a store
+    // and so they can be tested directly against the TypeScript publishers' field layout.
+    static ContractClass decode_class_log(const ContractClassLog& log);
+    static std::pair<AztecAddress, ContractInstance> decode_instance_log(const PrivateLog& log);
+
+  private:
+    struct Checkpoint {
+        unordered_flat_map<ContractClassId, ContractClassWithCommitment> contract_classes;
+        unordered_flat_map<AztecAddress, ContractInstance> contract_instances;
+        unordered_flat_map<GetDebugFunctionNameKey, std::string> debug_function_names;
+    };
+
+    unordered_flat_map<ContractClassId, ContractClassWithCommitment> contract_classes;
+    unordered_flat_map<AztecAddress, ContractInstance> contract_instances;
+    unordered_flat_map<GetDebugFunctionNameKey, std::string> debug_function_names;
+
+    std::stack<Checkpoint> checkpoints;
+    // Seeded with 0 and pushed as parent + 1, mirroring MemoryMerkleDB exactly.
+    std::stack<uint32_t> checkpoint_ids{ { 0 } };
+};
+
+} // namespace bb::avm2::simulation
