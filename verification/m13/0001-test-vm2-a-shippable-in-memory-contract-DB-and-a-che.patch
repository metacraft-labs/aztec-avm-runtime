+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include "barretenberg/vm2/simulation/interfaces/db.hpp"
+#include "barretenberg/vm2/simulation/standalone/concrete_dbs.hpp"
+#include "barretenberg/vm2/simulation/standalone/memory_contract_db.hpp"
+
+namespace bb::avm2::simulation {
+
+/**
+ * @brief The single owner of the two checkpoint stacks.
+ *
+ * THE PROBLEM. `ContractDBInterface` and `LowLevelMerkleDBInterface` each declare their own
+ * `create_checkpoint` / `commit_checkpoint` / `revert_checkpoint`, and nothing in either type
+ * relates one to the other. Inside a transaction upstream's `TxExecution` already drives the two
+ * together — `merkle_db.create_checkpoint(); contract_db.create_checkpoint();` at the end of setup,
+ * and the matching pairs on the app-logic and teardown paths — so within a simulation the pairing
+ * is upstream's and this class does not second-guess it. The gap is OUTSIDE a simulation, where a
+ * consumer opens a checkpoint per transaction or per block across the two DBs itself. Two
+ * independent stacks driven by hand drift, and when they do a reverted transaction leaves the
+ * contract state describing one history and the trees describing another. Nothing throws, nothing
+ * logs, and the divergence surfaces later as a wrong root with no path back to its cause.
+ *
+ * WHAT THIS DOES ABOUT IT. Everything that moves either stack goes through it: one
+ * `create_checkpoint` here is one on each DB, and likewise for commit and revert. It cannot ENFORCE
+ * that — both DBs' own checkpoint methods remain public, and must, since they are three of the
+ * eight and three of the fourteen the two interfaces declare — so "they were driven together" would
+ * otherwise be a claim about a program rather than about a state. Hence the state form of it: both
+ * DBs expose a checkpoint id with the same semantics — a stack seeded with 0 and `parent + 1`
+ * pushed on create — so `assert_lockstep()` compares three integers that must be EQUAL, and says
+ * which side moved when they are not. A stack moved behind this object's back is therefore reported
+ * at the next boundary rather than at the revert that produces the wrong state.
+ *
+ * WHEN THE INVARIANT HOLDS. Between operations at this level, which is what a consumer driving
+ * transaction and block boundaries sees. It does NOT hold part-way through
+ * `AvmSimAPI::simulate`: `TxExecution` pairs the two stacks at phase boundaries, but
+ * `ContextProvider` and `Execution` checkpoint the MERKLE db alone per call frame, deliberately,
+ * because a nested call can write storage and cannot publish a contract class. Both are balanced by
+ * the time the simulation returns, so the identity holds before and after each call and is asserted
+ * there.
+ *
+ * WHY IT OBSERVES A CONCRETE STORE. `LowLevelMerkleDBInterface` declares `get_checkpoint_id()`;
+ * `ContractDBInterface` does not, and adding it there would oblige all eight implementations
+ * upstream has. So the contract side is observed through the concrete `MemoryContractDB` while
+ * being DRIVEN through the interface. That asymmetry is a fact about the interface rather than a
+ * shortcut, and it is the one change to `ContractDBInterface` worth proposing separately.
+ *
+ * THE DECORATOR IS IN THE CHAIN. The `ContractDBInterface&` this hands out is a `PureContractDB`
+ * wrapping the store, never the store itself, so a consumer inherits whatever that decorator does
+ * today and whatever it grows to do. `simulate_fast_internal` wraps whatever raw DB it is given in
+ * one of its own as well; passing it the decorator means it decorates a decorator, which is
+ * harmless — both forward — and is preferable to handing the interpreter a raw store on the
+ * argument that one of the two layers is currently redundant.
+ */
+class CheckpointCoordinator {
+  public:
+    CheckpointCoordinator(MemoryContractDB& contract_store, LowLevelMerkleDBInterface& merkle_db)
+        : store(contract_store)
+        , decorated(contract_store)
+        , merkle(merkle_db)
+    {}
+
+    CheckpointCoordinator(const CheckpointCoordinator&) = delete;
+    CheckpointCoordinator& operator=(const CheckpointCoordinator&) = delete;
+    CheckpointCoordinator(CheckpointCoordinator&&) = delete;
+    CheckpointCoordinator& operator=(CheckpointCoordinator&&) = delete;
+    ~CheckpointCoordinator() = default;
+
+    // What a consumer passes to AvmSimAPI::simulate. The contract side is the decorator.
+    ContractDBInterface& contract_db() { return decorated; }
+    LowLevelMerkleDBInterface& merkle_db() { return merkle; }
+    MemoryContractDB& contract_store() { return store; }
