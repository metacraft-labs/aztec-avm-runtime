+    // every coordinated operation, so a stack moved behind this object's back is reported at the
+    // next boundary rather than at the revert that produces the wrong state.
+    void assert_lockstep() const;
+
+  private:
+    MemoryContractDB& store;
+    PureContractDB decorated;
+    LowLevelMerkleDBInterface& merkle;
+    uint32_t coordinated_depth = 0;
+};
