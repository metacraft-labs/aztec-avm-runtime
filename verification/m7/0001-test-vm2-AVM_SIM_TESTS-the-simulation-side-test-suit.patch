+# AVM_SIM_TESTS: give vm2_sim its own TEST_SOURCE_FILES, so `vm2_sim_tests` is built by
+# barretenberg's OWN module machinery (the same add_executable, the same gtest linkage, the
+# same WASM stack-size link option) instead of a bespoke runner. It is the simulation-side
+# subset of what the native `vm2_tests` binary carries: `vm2_tests` is created by the
+# `if(AVM)` block below out of *every* *.test.cpp under vm2/, and that binary links
+# `sumcheck stdlib_honk_verifier goblin_avm` plus `dsl` -- the proving stack an AVM_WASM
+# build deliberately excludes. The tests whose sources live beside vm2_sim's own sources do
+# not need any of it.
+#
+# Default OFF and additive: with the option off, not one target moves in any configuration.
+if(AVM_SIM_TESTS)
+  file(GLOB_RECURSE VM2_SIM_TEST_SOURCE_FILES
+    simulation/*.test.cpp
+    common/*.test.cpp
+    tooling/*.test.cpp
+  )
+  # The test-support translation units. Upstream compiles these into the `vm2` module (they
+  # are part of its ALL_SOURCE_FILES glob), which is proving-side; they are test-only, so
+  # here they go into the test objects. `keccakf1600_fixture.test.cpp` is deliberately NOT
+  # among them: it is a tracegen fixture, used only by constraining/ and tracegen/ tests.
+  file(GLOB VM2_SIM_TEST_SUPPORT_FILES testing/*.cpp)
+  list(FILTER VM2_SIM_TEST_SUPPORT_FILES EXCLUDE REGEX ".*\\.(test|bench|fuzzer)\\.cpp$")
+  list(APPEND VM2_SIM_TEST_SOURCE_FILES ${VM2_SIM_TEST_SUPPORT_FILES})
+  # common/avm_io.test.cpp is the only test here that calls a tracegen-bound fixture
+  # (testing::get_minimal_trace_with_pi), which AVM_SIM_TESTS_WITHOUT_TRACEGEN compiles out.
+  list(FILTER VM2_SIM_TEST_SOURCE_FILES EXCLUDE REGEX ".*/avm_io\\.test\\.cpp$")
+
+  barretenberg_module_with_sources(
+    vm2_sim
+    SOURCE_FILES ${VM2_SIM_SOURCE_FILES}
+    TEST_SOURCE_FILES ${VM2_SIM_TEST_SOURCE_FILES}
+    DEPENDENCIES crypto_merkle_tree world_state_reference
+  )
+  # The two fixtures in testing/fixtures.cpp that build a tracegen trace.
+  target_compile_definitions(vm2_sim_test_objects PRIVATE AVM_SIM_TESTS_WITHOUT_TRACEGEN)
+  if(WASM)
+    # wasi-libc's `_start` reaches the program through `__main_void`, which references the
+    # entry point WEAKLY -- and wasi-sdk's clang renames `int main(int, char**)` to
+    # `__main_argc_argv`, which is what libgtest_main.a actually defines. wasm-ld therefore
+    # never searches that archive, the entry resolves to an undefined-weak stub, and the
+    # module traps at `unreachable` before the first test runs (`llvm-nm` on such a binary
+    # shows `__main_void` and no entry point at all). Naming the symbol as required makes the
+    # linker pull gtest's OWN main, so the wasm binary runs the same program as the native
+    # one instead of a bespoke runner.
+    target_link_options(vm2_sim_tests PRIVATE -Wl,-u,__main_argc_argv)
+  endif()
+else()
+  # Build vm2_sim module (for nodejs bindings)
+  barretenberg_module_with_sources(
+    vm2_sim
+    SOURCE_FILES ${VM2_SIM_SOURCE_FILES}
+    DEPENDENCIES crypto_merkle_tree world_state_reference
+  )
+endif()
 
 # vm2_sim needs -fPIC because it's linked into the nodejs_module shared library
 set_target_properties(vm2_sim_objects PROPERTIES POSITION_INDEPENDENT_CODE ON)
