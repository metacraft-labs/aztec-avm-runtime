+int failures = 0;
+int checks = 0;
+
+void report(const std::string& name, const std::string& origin, const std::string& declared_in, bool ok, size_t bytes)
+{
+    ++checks;
+    if (!ok) {
+        ++failures;
+    }
+    std::cout << "msgpack." << name << " origin=" << origin << " declaredIn=" << declared_in
+              << " roundTrip=" << (ok ? "1" : "0") << " bytes=" << bytes << "\n";
+}
+
+bool same(const msgpack::sbuffer& a, const msgpack::sbuffer& b)
+{
+    return a.size() == b.size() && std::memcmp(a.data(), b.data(), a.size()) == 0;
+}
+
+// value: a populated instance. mutated: the same with ONE field changed.
+//
+// The comparison is on the RE-PACKED BYTES rather than on `operator==`, for two reasons. Several
+// of these types do not declare one at all (`SequentialInsertionResult` is the first), so an
+// equality-based check would silently narrow the enumeration to the types that happen to have it.
+// And bytes are the stronger question anyway: a `convert` that quietly drops a field round-trips
+// equal under a hand-written `operator==` that does not read it, and does not round-trip equal
+// here, because the re-pack emits that field's default.
+template <typename T>
+void covers(const std::string& name, const std::string& origin, const std::string& declared_in, const T& value, const T& mutated)
+{
+    msgpack::sbuffer packed;
+    msgpack::pack(packed, value);
+    T back;
+    msgpack::unpack(packed.data(), packed.size()).get().convert(back);
+    msgpack::sbuffer repacked;
+    msgpack::pack(repacked, back);
+    const bool round_trips = same(packed, repacked);
+
+    // The mutated copy must encode DIFFERENTLY. Without this a round-trip check passes for a
+    // schema that names no fields at all -- it would encode an empty map both times.
+    msgpack::sbuffer other;
+    msgpack::pack(other, mutated);
+    const bool discriminates = !same(packed, other);
+
+    report(name, origin, declared_in, round_trips && discriminates && packed.size() > 0, packed.size());
+    if (!round_trips) {
+        std::cout << "msgpack." << name << ".roundTripBytesDiffer 1\n";
+    }
+    if (!discriminates) {
+        std::cout << "msgpack." << name << ".encodingDiscriminates 0\n";
+    }
+}
