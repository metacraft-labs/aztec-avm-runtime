index e8622cbdd41..0199a1dc84b 100644
--- a/barretenberg/cpp/src/barretenberg/vm2/CMakeLists.txt
+++ b/barretenberg/cpp/src/barretenberg/vm2/CMakeLists.txt
@@ -100,6 +100,194 @@ if(AVM_DIFFERENTIAL)
   endif()
 endif()
 
+# AVM_REACTOR: avm.wasm -- the standalone AVM reactor.
+#
+# ONE WebAssembly module carrying the AVM (`vm2_sim`), its in-memory reference world state
+# (`world_state_reference`) and nothing else, so a page that only executes a public transaction
+# never downloads the proving stack. It has no `main`: it is a WASI *reactor*, initialised through
+# `_initialize` and then called through its exports.
+#
+# It lives in `reactor/`, which -- like `differential/` -- is deliberately NOT one of the
+# directories vm2_sim globs, and is excluded explicitly from the `if(AVM)` block below so it can
+# never end up inside a library archive.
+#
+# THE EXPORT LIST IS WRITTEN OUT AND NOTHING ELSE IS EXPORTED. `--export-dynamic` is deliberately
+# not passed: with it, every `visibility("default")` symbol in the link closure becomes an export
+# and the module's surface would be whatever the compiler happened to leave visible. Each name
+# below is also a `--gc-sections` root, so the two options together are what "exports pruned"
+# means here -- the reachable set is exactly what these names reach.
+#
+# Default OFF and additive: with the option off, not one target moves in any configuration.
+if(AVM_REACTOR)
+    # The msgpack enumeration, built for BOTH targets. It has no main-less linkage requirements and
+    # needs no test support, so it is a plain executable in both configurations.
+    add_executable(avm_msgpack_coverage
+        ${CMAKE_CURRENT_SOURCE_DIR}/reactor/avm_msgpack_coverage.cpp
+    )
+    target_link_libraries(avm_msgpack_coverage PRIVATE vm2_sim)
+    if(WASM)
+        target_link_options(avm_msgpack_coverage PRIVATE -Wl,-z,stack-size=8388608)
+    endif()
+
+    if(WASM)
+        # The test-support translation units, for the same reason AVM_DIFFERENTIAL takes them: they
+        # are the set already known to compile and link without the proving stack, and
+        # `TestContractDB` -- the only in-memory raw ContractDBInterface upstream has -- is among
+        # them. Which raw contract DB ships is M13's deliverable, not this target's.
+        file(GLOB VM2_REACTOR_SUPPORT_FILES testing/*.cpp)
+        list(FILTER VM2_REACTOR_SUPPORT_FILES EXCLUDE REGEX ".*\\.(test|bench|fuzzer)\\.cpp$")
+
+        add_executable(avm-reactor-debug.wasm
+            ${CMAKE_CURRENT_SOURCE_DIR}/reactor/avm_reactor.cpp
+            ${VM2_REACTOR_SUPPORT_FILES}
+        )
+        target_compile_definitions(avm-reactor-debug.wasm PRIVATE AVM_SIM_TESTS_WITHOUT_TRACEGEN)
+        target_link_libraries(avm-reactor-debug.wasm PRIVATE vm2_sim)
+
+        set(AVM_REACTOR_EXPORTS
+            avm_abi_version
+            avm_alloc
+            avm_free
+            avm_result_ptr
+            avm_result_len
+            avm_simulate
+            avm_simulate_with_hinted_dbs
+            avm_steps_count
+            avm_steps_batch
+            avm_contract_db_create
+            avm_contract_db_destroy
+            avm_contract_db_get_contract_instance
+            avm_contract_db_get_contract_class
+            avm_contract_db_get_bytecode_commitment
+            avm_contract_db_get_debug_function_name
+            avm_contract_db_add_contracts
+            avm_contract_db_create_checkpoint
+            avm_contract_db_commit_checkpoint
+            avm_contract_db_revert_checkpoint
+            avm_contract_db_register_class
+            avm_contract_db_register_instance
+            avm_merkle_db_create
+            avm_merkle_db_destroy
+            avm_merkle_db_get_tree_roots
+            avm_merkle_db_get_sibling_path
+            avm_merkle_db_get_low_indexed_leaf
+            avm_merkle_db_get_leaf_value
+            avm_merkle_db_get_leaf_preimage_public_data_tree
+            avm_merkle_db_get_leaf_preimage_nullifier_tree
+            avm_merkle_db_insert_indexed_leaves_public_data_tree
+            avm_merkle_db_insert_indexed_leaves_nullifier_tree
+            avm_merkle_db_append_leaves
+            avm_merkle_db_pad_tree
+            avm_merkle_db_create_checkpoint
+            avm_merkle_db_commit_checkpoint
+            avm_merkle_db_revert_checkpoint
+            avm_merkle_db_get_checkpoint_id
+        )
+        set(AVM_REACTOR_EXPORT_FLAGS "")
+        foreach(_sym ${AVM_REACTOR_EXPORTS})
+            list(APPEND AVM_REACTOR_EXPORT_FLAGS "-Wl,--export=${_sym}")
+        endforeach()
+
+        target_link_options(avm-reactor-debug.wasm PRIVATE
+            -mexec-model=reactor
+            -Wl,--gc-sections
+            -Wl,-z,stack-size=8388608
+            ${AVM_REACTOR_EXPORT_FLAGS}
+        )
+
+        # Strip the debug info: `avm.wasm` is the shipped artefact and the size budget is measured
+        # on it, not on the linker's output.
+        add_custom_command(
+            OUTPUT ${CMAKE_BINARY_DIR}/bin/avm.wasm
+            COMMAND ${CMAKE_STRIP} ${CMAKE_BINARY_DIR}/bin/avm-reactor-debug.wasm -o ${CMAKE_BINARY_DIR}/bin/avm.wasm
+            DEPENDS avm-reactor-debug.wasm
+            COMMENT "Stripping debug info to create avm.wasm"
+        )
+        add_custom_target(avm.wasm ALL DEPENDS ${CMAKE_BINARY_DIR}/bin/avm.wasm)
+
+        # The gzipped size is the number the budget is stated in, so it is produced by the build
+        # rather than by whatever gzip the checking script happens to find.
+        add_custom_command(
+            OUTPUT ${CMAKE_BINARY_DIR}/bin/avm.wasm.gz
+            COMMAND gzip -9 -n -c ${CMAKE_BINARY_DIR}/bin/avm.wasm > ${CMAKE_BINARY_DIR}/bin/avm.wasm.gz
+            DEPENDS ${CMAKE_BINARY_DIR}/bin/avm.wasm
+            COMMENT "Creating gzipped avm.wasm"
+        )
+        add_custom_target(avm.wasm.gz ALL DEPENDS ${CMAKE_BINARY_DIR}/bin/avm.wasm.gz)
+
+        # THE CONTROL, so that "--gc-sections, exports pruned" is a measurement and not a claim.
+        # The same sources and the same objects, linked with `--export-dynamic` and WITHOUT
+        # `--gc-sections`: every `visibility("default")` symbol in the closure becomes an export and
+        # nothing unreachable is dropped. Stripped and gzipped the same way, so the two rows differ
+        # only by the two link options. A check that measured only `avm.wasm` would be green for a
+        # build in which neither option did anything.
+        add_executable(avm-reactor-unpruned.wasm
+            ${CMAKE_CURRENT_SOURCE_DIR}/reactor/avm_reactor.cpp
+            ${VM2_REACTOR_SUPPORT_FILES}
+        )
+        target_compile_definitions(avm-reactor-unpruned.wasm PRIVATE AVM_SIM_TESTS_WITHOUT_TRACEGEN)
+        target_link_libraries(avm-reactor-unpruned.wasm PRIVATE vm2_sim)
+        target_link_options(avm-reactor-unpruned.wasm PRIVATE
+            -mexec-model=reactor
+            -Wl,--export-dynamic
+            -Wl,-z,stack-size=8388608
+        )
+        add_custom_command(
+            OUTPUT ${CMAKE_BINARY_DIR}/bin/avm-unpruned.wasm
+            COMMAND ${CMAKE_STRIP} ${CMAKE_BINARY_DIR}/bin/avm-reactor-unpruned.wasm -o ${CMAKE_BINARY_DIR}/bin/avm-unpruned.wasm
+            DEPENDS avm-reactor-unpruned.wasm
+            COMMENT "Stripping the unpruned control"
+        )
+        add_custom_command(
+            OUTPUT ${CMAKE_BINARY_DIR}/bin/avm-unpruned.wasm.gz
+            COMMAND gzip -9 -n -c ${CMAKE_BINARY_DIR}/bin/avm-unpruned.wasm > ${CMAKE_BINARY_DIR}/bin/avm-unpruned.wasm.gz
+            DEPENDS ${CMAKE_BINARY_DIR}/bin/avm-unpruned.wasm
+            COMMENT "Creating gzipped unpruned control"
+        )
+        add_custom_target(avm-unpruned.wasm.gz ALL DEPENDS ${CMAKE_BINARY_DIR}/bin/avm-unpruned.wasm.gz)
+
+        # THE SECOND CONTROL, and the reason it exists is that the first one cannot isolate
+        # `--gc-sections` at all.
+        #
+        # MEASURED, and it corrects what this file used to say: wasm-ld garbage-collects BY
+        # DEFAULT — its own `--help` reads `--gc-sections  Enable garbage collection of unused
+        # sections (default)`. So `avm-reactor-unpruned.wasm` above, which merely omits the flag,
+        # still collects. What that control varies is `--export-dynamic`, which turns every
+        # `visibility("default")` symbol in the closure into a GC ROOT and therefore RETAINS code
+        # that pulls three more WASI functions in with it.
+        #
+        # Turning the collector off is a different and much larger thing, and it has to be said
+        # explicitly. Same objects, same explicit export list, one option changed: the module then
+        # imports forty-five WASI functions instead of eleven. Without this target, "--gc-sections
+        # and pruned exports, measured apart" is two claims sharing one measurement.
+        add_executable(avm-reactor-nogc.wasm
+            ${CMAKE_CURRENT_SOURCE_DIR}/reactor/avm_reactor.cpp
+            ${VM2_REACTOR_SUPPORT_FILES}
+        )
+        target_compile_definitions(avm-reactor-nogc.wasm PRIVATE AVM_SIM_TESTS_WITHOUT_TRACEGEN)
+        target_link_libraries(avm-reactor-nogc.wasm PRIVATE vm2_sim)
+        target_link_options(avm-reactor-nogc.wasm PRIVATE
+            -mexec-model=reactor
+            -Wl,--no-gc-sections
+            -Wl,-z,stack-size=8388608
+            ${AVM_REACTOR_EXPORT_FLAGS}
+        )
+        add_custom_command(
+            OUTPUT ${CMAKE_BINARY_DIR}/bin/avm-nogc.wasm
+            COMMAND ${CMAKE_STRIP} ${CMAKE_BINARY_DIR}/bin/avm-reactor-nogc.wasm -o ${CMAKE_BINARY_DIR}/bin/avm-nogc.wasm
+            DEPENDS avm-reactor-nogc.wasm
+            COMMENT "Stripping the no-gc control"
+        )
+        add_custom_command(
+            OUTPUT ${CMAKE_BINARY_DIR}/bin/avm-nogc.wasm.gz
+            COMMAND gzip -9 -n -c ${CMAKE_BINARY_DIR}/bin/avm-nogc.wasm > ${CMAKE_BINARY_DIR}/bin/avm-nogc.wasm.gz
+            DEPENDS ${CMAKE_BINARY_DIR}/bin/avm-nogc.wasm
+            COMMENT "Creating gzipped no-gc control"
+        )
+        add_custom_target(avm-nogc.wasm.gz ALL DEPENDS ${CMAKE_BINARY_DIR}/bin/avm-nogc.wasm.gz)
+    endif()
+endif()
+
 # vm2_sim needs -fPIC because it's linked into the nodejs_module shared library
 set_target_properties(vm2_sim_objects PROPERTIES POSITION_INDEPENDENT_CODE ON)
 
@@ -117,6 +265,8 @@ if(AVM)
   # The differential driver is a standalone executable with its own main(); it is never part of a
