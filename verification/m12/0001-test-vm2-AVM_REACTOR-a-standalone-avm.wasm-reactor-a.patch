+  list(FILTER VM2_SOURCE_FILES EXCLUDE REGEX ".*/reactor/.*\\.cpp$")
 
   # Make vm2 and vm2_sim sources mutually exclusive
   foreach(SIM_FILE ${VM2_SIM_SOURCE_FILES})
diff --git a/barretenberg/cpp/src/barretenberg/vm2/differential/avm_differential.cpp b/barretenberg/cpp/src/barretenberg/vm2/differential/avm_differential.cpp
index b5cb0ef0c32..09f31652ead 100644
--- a/barretenberg/cpp/src/barretenberg/vm2/differential/avm_differential.cpp
+++ b/barretenberg/cpp/src/barretenberg/vm2/differential/avm_differential.cpp
@@ -70,6 +70,8 @@
 #include <utility>
 #include <vector>
 
+#include "barretenberg/serialize/msgpack_impl.hpp"
+
 #include "barretenberg/vm2/common/avm_io.hpp"
 #include "barretenberg/vm2/common/aztec_types.hpp"
 #include "barretenberg/vm2/common/field.hpp"
@@ -905,6 +907,140 @@ void mode_benchsteps(const std::string& program, uint64_t reps)
     line("benchsteps.done", "1");
 }
 
+
+// ===========================================================================
+// M12 -- the standalone reactor's inputs.
+//
+// `reactorinputs` prints, per corpus program, the msgpack blobs a host needs to drive `avm.wasm`:
+// the two entry points' inputs and the four resident-DB seeding calls that put the reactor's own
+// contract DB and merkle DB into the state this tester is in at simulate time.
+//
+// NOTHING HERE RECOMPUTES ANYTHING UPSTREAM ALREADY COMPUTES. The transaction, the global
+// variables and the protocol contracts are lifted out of the `ExecutionHints` upstream's own
+// hint-collecting run produced; the deployment nullifier and the fee-juice public-data leaf are
+// READ BACK out of the tester's own trees at the index they landed at, rather than re-derived from
+// `DOM_SEP__*` constants and a fee-payer balance restated on our side. A constant restated
+// downstream is a constant that can drift away from upstream's silently, and `fund_fee_payer` is
+// private precisely because it is upstream's business and not ours.
+//
+// The blobs are printed as HEX ON STDOUT rather than written to files. Writing files would pull
+// `fopen` and its WASI surface into this translation unit, which is also compiled for wasm and
+// whose import surface other milestones measure.
+// ---------------------------------------------------------------------------
+std::string hexbytes(const msgpack::sbuffer& buf)
+{
+    static const char* D = "0123456789abcdef";
+    std::string out;
+    out.reserve(buf.size() * 2);
+    for (size_t i = 0; i < buf.size(); ++i) {
+        const auto b = static_cast<uint8_t>(buf.data()[i]);
+        out += D[(b >> 4) & 0xF];
+        out += D[b & 0xF];
+    }
+    return out;
+}
+
+template <typename T> void emit_blob(const std::string& key, const T& value)
+{
+    msgpack::sbuffer buf;
+    msgpack::pack(buf, value);
+    line(key + ".bytes", dec(static_cast<uint64_t>(buf.size())));
+    line(key, hexbytes(buf));
+}
+
+void mode_reactor_inputs()
+{
+    line("reactorInputs.version", "1");
+    line("reactorInputs.coverage", "seven-hand-assembled-corpus-programs-the-same-seven-M8-compares");
+
+    const auto programs = corpus();
+    line("reactorInputs.programs.count", dec(static_cast<uint64_t>(programs.size())));
+
+    for (const auto& [name, bytecode] : programs) {
+        const std::string p = "reactorInputs." + name;
+
+        PublicTxSimulationTester tester;
+        const auto contract = tester.deploy_contract(bytecode);
+
+        // The deployment nullifier, read back from the tree it was inserted into.
+        const auto after_deploy = tester.merkle_db().get_tree_roots();
+        const index_t nullifier_index = static_cast<index_t>(after_deploy.nullifier_tree.next_available_leaf_index) - 1;
+        const auto deployment_nullifier = tester.merkle_db().get_leaf_preimage_nullifier_tree(nullifier_index).leaf;
+
+        // ONE simulation on this tester, so `tx_count` is 0 and the transaction's first nullifier is
+        // the same one the default transcript's run used. It also runs `fund_fee_payer`, which is
+        // what puts the fee-juice leaf in the public data tree.
+        auto hint_config = PublicTxSimulationTester::default_config();
+        hint_config.collect_hints = true;
+        hint_config.collect_public_inputs = true;
+        hint_config.collect_statistics = true;
+        const auto hinted = tester.simulate_tx({ TestEnqueuedCall{ .contract_address = contract.address } }, hint_config);
+        if (!hinted.hints.has_value() || !hinted.public_inputs.has_value()) {
+            std::cerr << "avm_differential: hint collection produced no hints or no public inputs for " << name << "\n";
+            std::exit(2);
+        }
+
+        const auto after_fund = tester.merkle_db().get_tree_roots();
+        const index_t public_data_index =
+            static_cast<index_t>(after_fund.public_data_tree.next_available_leaf_index) - 1;
+        const auto fee_juice_leaf = tester.merkle_db().get_leaf_preimage_public_data_tree(public_data_index).leaf;
+
+        line(p + ".address", hex(contract.address));
+        line(p + ".bytes", dec(static_cast<uint64_t>(bytecode.size())));
+        line(p + ".setup.nullifierIndex", dec(static_cast<uint64_t>(nullifier_index)));
+        line(p + ".setup.publicDataIndex", dec(static_cast<uint64_t>(public_data_index)));
+
+        // The four resident-DB seeding calls, each an upstream type.
+        emit_blob(p + ".setup.class", contract.contract_class);
+        emit_blob(p + ".setup.instance", std::make_tuple(contract.address, contract.instance));
+        emit_blob(p + ".setup.nullifier", deployment_nullifier);
+        emit_blob(p + ".setup.publicdata", fee_juice_leaf);
+
+        // `simulate` with host-provided DB references. The config asks for exactly what the default
+        // transcript's run asks for, so the two are comparable line for line.
+        AvmFastSimulationInputs fast{
+            .ws_revision = {},
+            .config = PublicTxSimulationTester::default_config(),
+            .tx = hinted.hints->tx,
+            .global_variables = hinted.hints->global_variables,
+            .protocol_contracts = hinted.hints->protocol_contracts,
+        };
+        fast.config.collect_statistics = true;
+        fast.config.collect_public_inputs = true;
+        emit_blob(p + ".fast", fast);
+
+#if AVM_HAS_EXECUTION_OBSERVER
+        // The same, with the observation hook on, for the step-stream measurement.
+        AvmFastSimulationInputs fast_steps = fast;
+        fast_steps.config.collect_execution_steps = true;
+        emit_blob(p + ".faststeps", fast_steps);
+#endif
+
+        // `simulate_with_hinted_dbs`: self-contained, no DB handle involved.
+        const AvmProvingInputs proving{ .public_inputs = *hinted.public_inputs, .hints = *hinted.hints };
+        emit_blob(p + ".proving", proving);
+
+        // Per-program arguments for the exported ContractDBInterface lookups.
+        emit_blob(p + ".args.address", contract.address);
+        emit_blob(p + ".args.classId", contract.contract_class.id);
+        emit_blob(p + ".args.debugName", std::make_tuple(contract.address, FunctionSelector(0)));
+    }
+
+    // Arguments for the exported LowLevelMerkleDBInterface methods that do not depend on a program.
+    // Each is an upstream type or a msgpack array of upstream types; none is a schema of ours.
+    emit_blob("reactorInputs.args.treeIndex", std::make_tuple(MerkleTreeId::NOTE_HASH_TREE, uint64_t(0)));
+    emit_blob("reactorInputs.args.treeValue", std::make_tuple(MerkleTreeId::NULLIFIER_TREE, FF(144)));
+    emit_blob("reactorInputs.args.leafIndex", uint64_t(0));
+    emit_blob("reactorInputs.args.appendLeaves",
+              std::make_tuple(MerkleTreeId::NOTE_HASH_TREE, std::vector<FF>{ FF(42) }));
+    emit_blob("reactorInputs.args.padTree", std::make_tuple(MerkleTreeId::NOTE_HASH_TREE, uint64_t(5)));
+    emit_blob("reactorInputs.args.nullifierLeaf", NullifierLeafValue(FF(144)));
+    emit_blob("reactorInputs.args.publicDataLeaf", PublicDataLeafValue(FF(145), FF(1)));
+    emit_blob("reactorInputs.args.emptyDeployment", ContractDeploymentData{});
+
+    line("reactorInputs.done", "1");
+}
+
 } // namespace
 
 int main(int argc, char** argv)
@@ -921,6 +1057,10 @@ int main(int argc, char** argv)
         mode_events();
         return 0;
     }
+    if (mode == "reactorinputs") {
+        mode_reactor_inputs();
+        return 0;
+    }
     if (mode == "bench" || mode == "benchsteps") {
         if (argc < 4) {
             std::cerr << "usage: avm_differential " << mode << " <program> <reps>\n";
diff --git a/barretenberg/cpp/src/barretenberg/vm2/reactor/avm_msgpack_coverage.cpp b/barretenberg/cpp/src/barretenberg/vm2/reactor/avm_msgpack_coverage.cpp
new file mode 100644
index 00000000000..cf20241b6d4
--- /dev/null
+++ b/barretenberg/cpp/src/barretenberg/vm2/reactor/avm_msgpack_coverage.cpp
@@ -0,0 +1,725 @@
+// The host-ABI msgpack enumeration, BY EXECUTION.
+//
+// M12's deliverable is phrased the right way round: *confirm upstream's generated schemas cover the
+// surface we cross, and only then define anything of our own for what they do not*. This program is
+// that confirmation. For every type that crosses the reactor boundary it
+//
+//   1. builds a value with non-default content in every field it names,
+//   2. packs it with msgpack and unpacks it back,
+//   3. asserts the round-trip is equal, and
+//   4. asserts a MUTATED copy is NOT equal — because a round-trip check over a type whose
+//      `operator==` returns true for everything passes for the wrong reason, and this campaign has
+//      already had one membership test pass over an empty haystack.
+//
+// A type with no schema does not fail here: it fails to COMPILE. That is the point of doing the
+// enumeration in C++ rather than by grepping for `MSGPACK_CAMEL_CASE_FIELDS` — a grep tells you a
+// macro is present, a compile tells you the packer and the unpacker both exist and agree.
+//
+// Each line names where the schema is DECLARED, so "upstream's schema" is a claim about a file and
+// not an impression. `origin=upstream` means the declaration is in a file no overlay of ours
+// touches; `origin=prepared-patch` means it is added by one of the five prepared upstream
+// contributions (only `ExecutionStep` and `TxSimulationResult::execution_steps`, from the
+// per-instruction observation hook); `origin=ours` means we declared it, and the reason is printed.
+//
+// Built for x86-64 AND for wasm32-wasip1 from the same translation unit, because a schema that
+// round-trips on one target and not the other is exactly the kind of thing this campaign measures
+// rather than assumes.
+
