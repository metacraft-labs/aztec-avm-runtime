+        covers("DebugLog", "upstream", AZTEC_TYPES, v, m);
+    }
+
+    // ---- the merkle-tree types the low-level DB returns ---------------------------------------
+    {
+        auto v = nullifier_leaf();
+        auto m = v;
+        m.nextIndex = 999;
+        covers("IndexedLeaf<NullifierLeafValue>", "upstream", INDEXED_LEAF, v, m);
+    }
+    {
+        auto v = public_data_leaf();
+        auto m = v;
+        m.nextIndex = 999;
+        covers("IndexedLeaf<PublicDataLeafValue>", "upstream", INDEXED_LEAF, v, m);
+    }
+    {
+        auto v = NullifierLeafValue(f(271));
+        auto m = NullifierLeafValue(f(272));
+        covers("NullifierLeafValue", "upstream", INDEXED_LEAF, v, m);
+    }
+    {
+        auto v = PublicDataLeafValue(f(281), f(282));
+        auto m = PublicDataLeafValue(f(281), f(283));
+        covers("PublicDataLeafValue", "upstream", INDEXED_LEAF, v, m);
+    }
+    {
+        auto v = witness(nullifier_leaf());
+        auto m = v;
+        m.index = 999;
+        covers("LeafUpdateWitnessData<NullifierLeafValue>", "upstream", RESPONSE, v, m);
+    }
+    {
+        SequentialInsertionResult<NullifierLeafValue> v{ .low_leaf_witness_data = { witness(nullifier_leaf()) },
+                                                         .insertion_witness_data = { witness(nullifier_leaf()) } };
+        auto m = v;
+        m.insertion_witness_data[0].index = 999;
+        covers("SequentialInsertionResult<NullifierLeafValue>", "upstream", RESPONSE, v, m);
+    }
+    {
+        SequentialInsertionResult<PublicDataLeafValue> v{ .low_leaf_witness_data = { witness(public_data_leaf()) },
+                                                          .insertion_witness_data = { witness(public_data_leaf()) } };
+        auto m = v;
+        m.insertion_witness_data[0].index = 999;
+        covers("SequentialInsertionResult<PublicDataLeafValue>", "upstream", RESPONSE, v, m);
+    }
+    {
+        GetLowIndexedLeafResponse v{ true, 5 };
+        GetLowIndexedLeafResponse m{ false, 5 };
+        covers("GetLowIndexedLeafResponse", "upstream", RESPONSE, v, m);
+    }
+    {
+        auto v = WorldStateRevision{ .forkId = 1, .blockNumber = 2, .includeUncommitted = true };
+        auto m = v;
+        m.blockNumber = 3;
+        covers("WorldStateRevision", "upstream", MERKLE_TREE_ID, v, m);
+    }
+
+    // ---- enums, which msgpack needs registered explicitly --------------------------------------
+    {
+        auto v = MerkleTreeId::PUBLIC_DATA_TREE;
+        auto m = MerkleTreeId::NOTE_HASH_TREE;
+        covers("MerkleTreeId", "upstream", MERKLE_TREE_ID, v, m);
+    }
+    {
+        auto v = RevertCode::TEARDOWN_REVERTED;
+        auto m = RevertCode::OK;
+        covers("RevertCode", "upstream", AZTEC_TYPES, v, m);
+    }
+    {
+        auto v = CoarseTransactionPhase::TEARDOWN;
+        auto m = CoarseTransactionPhase::SETUP;
+        covers("CoarseTransactionPhase", "upstream", AVM_IO, v, m);
+    }
+
+    // ---- the multi-argument encodings the exported DB methods use ------------------------------
+    // These are msgpack-c's OWN std::tuple adaptor over types already covered above. Nothing here
+    // declares a schema; the entry exists so "the arguments cross as upstream types" is measured
+    // and not asserted in prose.
+    {
+        std::tuple<MerkleTreeId, uint64_t> v{ MerkleTreeId::NULLIFIER_TREE, 7 };
+        std::tuple<MerkleTreeId, uint64_t> m{ MerkleTreeId::NULLIFIER_TREE, 8 };
+        covers("tuple<MerkleTreeId,uint64>", "msgpack-adaptor", "msgpack/adaptor/cpp11/tuple.hpp", v, m);
+    }
+    {
+        std::tuple<MerkleTreeId, std::vector<FF>> v{ MerkleTreeId::NOTE_HASH_TREE, { f(291), f(292) } };
+        std::tuple<MerkleTreeId, std::vector<FF>> m{ MerkleTreeId::NOTE_HASH_TREE, { f(291) } };
+        covers("tuple<MerkleTreeId,vector<FF>>", "msgpack-adaptor", "msgpack/adaptor/cpp11/tuple.hpp", v, m);
+    }
+    {
+        std::tuple<AztecAddress, ContractInstance> v{ f(301), instance() };
+        std::tuple<AztecAddress, ContractInstance> m{ f(302), instance() };
+        covers("tuple<AztecAddress,ContractInstance>", "msgpack-adaptor", "msgpack/adaptor/cpp11/tuple.hpp", v, m);
+    }
+    {
+        std::tuple<AztecAddress, FunctionSelector> v{ f(311), f(312) };
+        std::tuple<AztecAddress, FunctionSelector> m{ f(311), f(313) };
+        covers("tuple<AztecAddress,FunctionSelector>", "msgpack-adaptor", "msgpack/adaptor/cpp11/tuple.hpp", v, m);
+    }
+    {
+        std::optional<ContractInstance> v = instance();
+        std::optional<ContractInstance> m = std::nullopt;
+        covers("optional<ContractInstance>", "msgpack-adaptor", "msgpack/adaptor/cpp11/optional.hpp", v, m);
+    }
+    {
+        std::vector<ExecutionStep> v{ step(1), step(2), step(3) };
+        std::vector<ExecutionStep> m{ step(1), step(2) };
+        covers("vector<ExecutionStep>", "msgpack-adaptor", "msgpack/adaptor/vector.hpp", v, m);
+    }
+    {
+        std::vector<FF> v{ f(321), f(322) };
+        std::vector<FF> m{ f(321) };
+        covers("SiblingPath", "msgpack-adaptor", "msgpack/adaptor/vector.hpp", v, m);
+    }
+
+    // ---- the one type this campaign declares ---------------------------------------------------
+    // Upstream HAS an error envelope: bb::bbapi::ErrorResponse in bbapi/bbapi_shared.hpp, with the
+    // same single `message` field and the same SERIALIZATION_FIELDS. It is not usable here: the
+    // `bbapi` module's own dependency line is
+    // `barretenberg_module(bbapi common chonk dsl crypto_poseidon2 ... ecc srs)`, which is the
+    // proving stack this artefact exists to exclude, and the header is not includable on its own
+    // (it names ChonkStepProcessor and acir_format::AcirFormat). Ours is shaped identically so a
+    // host decoder written for upstream's decodes it unchanged.
+    {
+        AvmReactorError v{ .message = "boom" };
+        AvmReactorError m{ .message = "other" };
+        covers("AvmReactorError", "ours", REACTOR, v, m);
+    }
+
+    std::cout << "msgpackCoverage.checks " << checks << "\n";
+    std::cout << "msgpackCoverage.failures " << failures << "\n";
+    return failures == 0 ? 0 : 1;
+}
