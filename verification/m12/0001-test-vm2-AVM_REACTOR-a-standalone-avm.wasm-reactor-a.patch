@@ -0,0 +1,570 @@
+// avm.wasm — the standalone AVM reactor.
+//
+// One WebAssembly module containing the AVM (`vm2_sim`), its in-memory reference world state
+// (`world_state_reference`) and nothing else, so a page that only executes a public transaction
+// never downloads the proving stack. It has no `main`: it is a WASI *reactor*, initialised once
+// through `_initialize` and then called through the exports below.
+//
+// THE HOST ABI IS UPSTREAM'S OWN MSGPACK SCHEMAS, NOT AN ENCODING OF OURS.
+//
+// Every value that crosses this boundary is a type Aztec already declared with
+// `MSGPACK_CAMEL_CASE_FIELDS`, `SERIALIZATION_FIELDS`, a hand-written `msgpack()` or
+// `MSGPACK_ADD_ENUM` — `AvmFastSimulationInputs`, `AvmProvingInputs`, `TxSimulationResult`,
+// `ExecutionStep`, `ContractInstance`, `ContractClassWithCommitment`, `ContractDeploymentData`,
+// `TreeSnapshots`, `IndexedLeaf<...>`, `SequentialInsertionResult<...>`,
+// `GetLowIndexedLeafResponse`, `MerkleTreeId`. Where a method takes more than one argument they
+// are packed as a msgpack ARRAY of those same types (msgpack-c's own `std::tuple` adaptor); that
+// is an encoding msgpack provides, not a schema we declared.
+//
+// EXACTLY ONE TYPE IS OURS, and the reason is specific rather than stylistic. Upstream does have
+// a msgpack error envelope — `bb::bbapi::ErrorResponse { std::string message; }` in
+// `bbapi/bbapi_shared.hpp` — but it is declared inside the `bbapi` module, whose own
+// `barretenberg_module(bbapi common chonk dsl crypto_poseidon2 ... ecc srs)` line pulls the
+// proving stack this artefact exists to exclude, and the header is not includable on its own
+// (it names `ChonkStepProcessor` and `acir_format::AcirFormat`). So `AvmReactorError` below is
+// declared here — with the SAME single `message` field and the same `SERIALIZATION_FIELDS`, so a
+// host decoder written against upstream's `ErrorResponse` decodes ours unchanged, and so that
+// deleting ours in favour of upstream's is a one-line change if `bbapi` is ever split.
+//
+// WHY THERE IS NO IMPORTED DB SURFACE.
+//
+// The two host interfaces, `ContractDBInterface` (eight methods) and `LowLevelMerkleDBInterface`
+// (fourteen), are exposed as wasm EXPORTS over implementations resident in this module — not as
+// imported callbacks the host implements. That is deliberate and it is what keeps this module's
+// import surface to WASI alone: an imported DB callback would be a foreign-call surface, and the
+// AVM has none (unlike the private ACVM/Brillig side). The host-implemented, imported-callback
+// shape is M15's "chatty" arm and is measured there against this one; nothing here forecloses it.
+//
+// `HighLevelMerkleDBInterface` is deliberately NOT exposed. It is internal to vm2 and
+// `simulate_fast_internal` satisfies it itself with `PureMerkleDB`, exactly as it wraps whatever
+// raw contract DB it is handed in `PureContractDB`.
+//
+// THE RAW CONTRACT DB IS PROVISIONAL AND M13 OWNS IT. `TestContractDB` from `vm2/testing/` is the
+// only in-memory raw `ContractDBInterface` upstream has; `PureContractDB` is a decorator over a
+// raw one and the shippable raw one is the native, IPC-backed `cdb`. Whether `TestContractDB`
+// ships, is upstreamed as an in-memory store beside `PureContractDB`, or is replaced is M13's
+// deliverable. This module names it in one place so that decision is a one-line change here.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include "barretenberg/common/wasm_export.hpp"
+#include "barretenberg/serialize/msgpack.hpp"
+#include "barretenberg/serialize/msgpack_impl.hpp"
+
+#include "barretenberg/vm2/avm_sim_api.hpp"
+#include "barretenberg/vm2/common/avm_io.hpp"
+#include "barretenberg/vm2/common/aztec_types.hpp"
+#include "barretenberg/vm2/simulation/interfaces/db.hpp"
+#include "barretenberg/vm2/simulation/lib/memory_merkle_db.hpp"
+#include "barretenberg/vm2/testing/public_tx_simulation_tester.hpp"
+
+namespace {
+
+using namespace bb::avm2;
+using bb::avm2::simulation::MemoryMerkleDB;
+using bb::avm2::testing::TestContractDB;
+using bb::crypto::merkle_tree::NullifierLeafValue;
+using bb::crypto::merkle_tree::PublicDataLeafValue;
+using bb::world_state::MerkleTreeId;
+
+using index_t = bb::crypto::merkle_tree::index_t;
+
+// The one type this module declares. Shaped exactly like upstream's bbapi::ErrorResponse.
+struct AvmReactorError {
+    std::string message;
+
+    bool operator==(const AvmReactorError& other) const = default;
+
+    SERIALIZATION_FIELDS(message);
+};
+
+// ---------------------------------------------------------------------------
+// The result buffer.
+//
+// Every call that produces bytes leaves them here and returns a status; the host then reads
+// `avm_result_ptr()` / `avm_result_len()`. One buffer, reused, owned by the module: the alternative
+// — returning a freshly allocated pointer the host must free — makes every error path a leak, and
+// M12's own alloc/free check exists because that is the failure this shape removes.
+//
+// It is NOT `avm_alloc`ed. Input buffers are the host's to allocate and free; this one is the
+// module's and is never handed to `avm_free`.
+std::vector<uint8_t> g_result;
+
+// The step stream of the most recent simulation, kept so it can be drained in BATCHES rather than
+// re-encoded per call. See avm_steps_batch.
+std::vector<ExecutionStep> g_steps;
+
+void set_result(const msgpack::sbuffer& buf)
+{
+    g_result.assign(buf.data(), buf.data() + buf.size());
+}
+
+template <typename T> void pack_result(const T& value)
+{
+    msgpack::sbuffer buf;
+    msgpack::pack(buf, value);
+    set_result(buf);
+}
+
+void clear_result()
+{
+    g_result.clear();
+}
+
+template <typename T> T unpack_args(const uint8_t* data, uint32_t len)
+{
+    T out;
+    msgpack::unpack(reinterpret_cast<const char*>(data), len).get().convert(out);
+    return out;
+}
+
+// Status codes. 0 is success; everything else leaves an AvmReactorError in the result buffer.
+constexpr int32_t AVM_OK = 0;
+constexpr int32_t AVM_ERR_EXCEPTION = 1; // a std::exception escaped — including a bad input decode
+constexpr int32_t AVM_ERR_UNKNOWN = 2;   // a non-std::exception escaped
+constexpr int32_t AVM_ERR_HANDLE = 3;    // no such DB handle
+
+void set_error(const std::string& message)
+{
+    pack_result(AvmReactorError{ .message = message });
+}
+
+// Every export runs its body through this. A C++ exception must never unwind out of a wasm export:
+// it would trap the instance, and a trapped instance and a reverted transaction are not the same
+// thing (M17 enforces that distinction on the host side; this is its C++ half).
+template <typename F> int32_t guarded(F&& body)
+{
+    try {
+        body();
+        return AVM_OK;
+    } catch (const std::exception& e) {
+        set_error(e.what());
+        return AVM_ERR_EXCEPTION;
+    } catch (...) {
+        set_error("unknown exception");
+        return AVM_ERR_UNKNOWN;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// DB handles.
+//
+// A handle is an opaque uint32 the host holds. Resident DBs, not host callbacks.
+// ---------------------------------------------------------------------------
+uint32_t g_next_handle = 1;
+std::unordered_map<uint32_t, std::unique_ptr<MemoryMerkleDB>> g_merkle_dbs;
+std::unordered_map<uint32_t, std::unique_ptr<TestContractDB>> g_contract_dbs;
+
+MemoryMerkleDB* merkle_db(uint32_t handle)
+{
+    auto it = g_merkle_dbs.find(handle);
+    return it == g_merkle_dbs.end() ? nullptr : it->second.get();
+}
+
+TestContractDB* contract_db(uint32_t handle)
+{
+    auto it = g_contract_dbs.find(handle);
+    return it == g_contract_dbs.end() ? nullptr : it->second.get();
+}
+
+} // namespace
+
+// ===========================================================================
+// Linear memory
+// ===========================================================================
+
+// The host's way to place an input buffer in linear memory. Sized allocation on both sides so the
+// module never has to remember a length it was not told: `avm_free` is given back the same size,
+// which is what `operator delete[]` with a size wants and what keeps this a two-line pair rather
+// than a bookkeeping table.
+WASM_EXPORT uint8_t* avm_alloc(uint32_t size)
+{
+    if (size == 0) {
+        // A zero-size allocation must still return a distinct, freeable pointer: returning null
+        // would make "allocation failed" and "you asked for nothing" the same answer.
+        size = 1;
+    }
+    return new (std::nothrow) uint8_t[size];
+}
+
+WASM_EXPORT void avm_free(uint8_t* ptr, uint32_t size)
+{
+    (void)size;
+    delete[] ptr;
+}
+
+WASM_EXPORT uint32_t avm_result_ptr()
+{
+    return static_cast<uint32_t>(reinterpret_cast<uintptr_t>(g_result.data()));
+}
+
+WASM_EXPORT uint32_t avm_result_len()
+{
+    return static_cast<uint32_t>(g_result.size());
+}
+
+// The ABI version. Bumped when an export's meaning changes, so a host that loads a module it was
+// not written for fails at load rather than on a field it silently misreads.
+WASM_EXPORT uint32_t avm_abi_version()
+{
+    return 1;
+}
+
+// ===========================================================================
+// The two simulate entry points
+// ===========================================================================
+
+// Self-contained: everything the simulation needs is in `hints`, and no DB handle is involved.
+// Input: msgpack `AvmProvingInputs`. Result: msgpack `TxSimulationResult`.
+WASM_EXPORT int32_t avm_simulate_with_hinted_dbs(const uint8_t* inputs, uint32_t len)
+{
+    return guarded([&] {
+        std::vector<uint8_t> bytes(inputs, inputs + len);
+        const AvmProvingInputs parsed = AvmProvingInputs::from(bytes);
+        AvmSimAPI api;
+        const TxSimulationResult result = api.simulate_with_hinted_dbs(parsed);
+        g_steps = result.execution_steps.has_value() ? *result.execution_steps : std::vector<ExecutionStep>{};
+        pack_result(result);
+    });
+}
+
+// Host-provided DB references: the host names which resident contract DB and which resident merkle
+// DB to run against. Input: msgpack `AvmFastSimulationInputs`. Result: msgpack `TxSimulationResult`.
+WASM_EXPORT int32_t avm_simulate(const uint8_t* inputs, uint32_t len, uint32_t contract_db_handle, uint32_t merkle_db_handle)
+{
+    TestContractDB* cdb = contract_db(contract_db_handle);
+    MemoryMerkleDB* mdb = merkle_db(merkle_db_handle);
+    if (cdb == nullptr || mdb == nullptr) {
+        set_error("no such DB handle");
+        return AVM_ERR_HANDLE;
+    }
+    return guarded([&] {
+        std::vector<uint8_t> bytes(inputs, inputs + len);
+        const AvmFastSimulationInputs parsed = AvmFastSimulationInputs::from(bytes);
+        AvmSimAPI api;
+        const TxSimulationResult result = api.simulate(parsed, *cdb, *mdb, nullptr);
+        g_steps = result.execution_steps.has_value() ? *result.execution_steps : std::vector<ExecutionStep>{};
+        pack_result(result);
+    });
+}
+
+// ===========================================================================
+// The step stream, in batches
+// ===========================================================================
+//
+// The steps of the last simulation are already inside the `TxSimulationResult` this module returns,
+// under upstream's own `execution_steps` field — so a host that wants all of them has them after
+// ONE crossing. This pair exists for the case the result is decoded without them (a host that asks
+// for steps but not for the whole result, or one that streams them into a trace writer as it goes):
+// `avm_steps_batch(from, count)` re-encodes a WINDOW of the retained vector, so a run of N steps
+// costs ceil(N / batch) crossings rather than N.
+//
+// There is deliberately no per-step export. Measuring the rejected shape does not need one:
+// `avm_steps_batch(i, 1)` IS one crossing per step, through the same export, so the comparison is
+// between two call patterns rather than between two APIs.
+
+WASM_EXPORT uint32_t avm_steps_count()
+{
+    return static_cast<uint32_t>(g_steps.size());
+}
+
+WASM_EXPORT int32_t avm_steps_batch(uint32_t from, uint32_t count)
+{
+    return guarded([&] {
+        const size_t n = g_steps.size();
+        const size_t begin = from >= n ? n : static_cast<size_t>(from);
+        // Written as a subtraction rather than as `begin + count >= n`, because `size_t` is 32 bits
+        // on wasm32 and `count` is a uint32 the HOST supplies: `begin + count` wraps for a count
+        // near 2^32 - begin, and a wrapped `end` below `begin` would construct a vector from a
+        // reversed range. The window is clamped, so an out-of-range request is an empty or a
+        // truncated batch and never a trap.
+        const size_t end = static_cast<size_t>(count) >= (n - begin) ? n : begin + static_cast<size_t>(count);
+        const std::vector<ExecutionStep> window(g_steps.begin() + static_cast<ptrdiff_t>(begin),
+                                                g_steps.begin() + static_cast<ptrdiff_t>(end));
+        pack_result(window);
+    });
+}
+
+// ===========================================================================
+// ContractDBInterface — the eight methods, plus create/destroy and the two population entry
+// points the raw in-memory implementation needs. The eight are named for the interface methods
+// exactly, so the export list IS the interface.
+// ===========================================================================
+
+WASM_EXPORT uint32_t avm_contract_db_create()
+{
+    const uint32_t handle = g_next_handle++;
+    g_contract_dbs.emplace(handle, std::make_unique<TestContractDB>());
+    return handle;
+}
+
+WASM_EXPORT void avm_contract_db_destroy(uint32_t handle)
+{
+    g_contract_dbs.erase(handle);
+}
+
+#define AVM_CONTRACT_DB(handle)                                                                                        \
+    TestContractDB* db = contract_db(handle);                                                                          \
+    if (db == nullptr) {                                                                                               \
+        set_error("no such contract DB handle");                                                                       \
+        return AVM_ERR_HANDLE;                                                                                         \
+    }
+
+// args: msgpack AztecAddress. result: msgpack optional<ContractInstance>.
+WASM_EXPORT int32_t avm_contract_db_get_contract_instance(uint32_t handle, const uint8_t* args, uint32_t len)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] { pack_result(db->get_contract_instance(unpack_args<AztecAddress>(args, len))); });
+}
+
+// args: msgpack ContractClassId. result: msgpack optional<ContractClass>.
+WASM_EXPORT int32_t avm_contract_db_get_contract_class(uint32_t handle, const uint8_t* args, uint32_t len)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] { pack_result(db->get_contract_class(unpack_args<ContractClassId>(args, len))); });
+}
+
+// args: msgpack ContractClassId. result: msgpack optional<FF>.
+WASM_EXPORT int32_t avm_contract_db_get_bytecode_commitment(uint32_t handle, const uint8_t* args, uint32_t len)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] { pack_result(db->get_bytecode_commitment(unpack_args<ContractClassId>(args, len))); });
+}
+
+// args: msgpack [AztecAddress, FunctionSelector]. result: msgpack optional<string>.
+WASM_EXPORT int32_t avm_contract_db_get_debug_function_name(uint32_t handle, const uint8_t* args, uint32_t len)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] {
+        const auto [address, selector] = unpack_args<std::tuple<AztecAddress, FunctionSelector>>(args, len);
+        pack_result(db->get_debug_function_name(address, selector));
+    });
+}
+
+// args: msgpack ContractDeploymentData. no result.
+WASM_EXPORT int32_t avm_contract_db_add_contracts(uint32_t handle, const uint8_t* args, uint32_t len)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] {
+        db->add_contracts(unpack_args<ContractDeploymentData>(args, len));
+        clear_result();
+    });
+}
+
+WASM_EXPORT int32_t avm_contract_db_create_checkpoint(uint32_t handle)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] {
+        db->create_checkpoint();
+        clear_result();
+    });
+}
+
+WASM_EXPORT int32_t avm_contract_db_commit_checkpoint(uint32_t handle)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] {
+        db->commit_checkpoint();
+        clear_result();
+    });
+}
+
+WASM_EXPORT int32_t avm_contract_db_revert_checkpoint(uint32_t handle)
+{
+    AVM_CONTRACT_DB(handle)
+    return guarded([&] {
+        db->revert_checkpoint();
+        clear_result();
+    });
+}
+
+// Population. NOT part of ContractDBInterface: these are how the in-memory raw implementation is
+// seeded, and they are named after TestContractDB's own methods rather than dressed up as
+// interface ones. M13 decides what the shippable raw contract DB is; these two move with it.
