diff --git a/barretenberg/cpp/CMakeLists.txt b/barretenberg/cpp/CMakeLists.txt
index 9d49e5b395..1bb077d7ca 100644
--- a/barretenberg/cpp/CMakeLists.txt
+++ b/barretenberg/cpp/CMakeLists.txt
@@ -61,6 +61,7 @@ option(SYNTAX_ONLY "only check syntax (-fsyntax-only)" OFF)
 option(ENABLE_WASM_BENCH "Enable BB_BENCH benchmarking support in WASM builds (dev only, not for releases)" OFF)
 option(AVM "enable building of vm2 module and bb-avm" ON)
 option(BB_LITE "Exclude server-side subsystems: lmdb, world_state, ipc, nodejs_module" OFF)
+option(AVM_WASM "SPIKE: build vm2_sim for WASM (no lmdb, no world_state, real exceptions)" OFF)
 
 if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "arm64")
     message(STATUS "Compiling for ARM.")
@@ -190,6 +191,12 @@ if (NOT WASM AND NOT BB_LITE)
     include(cmake/lmdb.cmake)
 endif()
 
+if (WASM AND AVM_WASM)
+    # SPIKE: supply lmdb.h as a HEADER ONLY (no liblmdb.a). crypto_merkle_tree/types.hpp
+    # needs MDB_stat purely to declare DBStats; nothing in vm2_sim calls LMDB.
+    set(LMDB_INCLUDE "${CMAKE_CURRENT_SOURCE_DIR}/../../../shims")
+endif()
+
 if(AVM_TRANSPILER_LIB)
     include(cmake/avm-transpiler.cmake)
 endif()
