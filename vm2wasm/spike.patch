+++ b/barretenberg/cpp/src/barretenberg/vm2/simulation/interfaces/execution_observer.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+// SPIKE — per-instruction observation hook.
+//
+// The fast simulation loop (HybridExecution::execute) deliberately emits no ExecutionEvents, so
+// there is currently no step-level seam in the path a browser would use. This interface adds one:
+// a single virtual call per instruction, at the one place in the one file where the loop lives.
+//
+// Shape deliberately mirrors CallStackMetadataCollectorInterface, which upstream already injects
+// through the same constructor and gates behind PublicSimulatorConfig::collect_call_metadata.
+
+#include "barretenberg/vm2/common/aztec_types.hpp"
+#include "barretenberg/vm2/common/opcodes.hpp"
+#include "barretenberg/vm2/simulation/lib/serialization.hpp"
+
+namespace bb::avm2::simulation {
+
+class ExecutionObserverInterface {
+  public:
+    virtual ~ExecutionObserverInterface() = default;
+
+    // Called once per executed instruction, AFTER dispatch, with the state needed to build a
+    // CodeTracer step record: which frame, where, what ran, and what it cost.
+    virtual void on_instruction(uint32_t context_id,
+                                const AztecAddress& contract_address,
+                                PC pc,
+                                const Instruction& instruction,
+                                const Gas& gas_used) = 0;
+};
+
+// SPIKE SHORTCUT: a process-global so the driver can attach an observer without threading a new
+// parameter through simulate_fast_internal -> AvmSimulationHelper -> Execution's 20-argument
+// constructor. Upstream would inject it exactly like CallStackMetadataCollectorInterface.
+// Used ONLY to measure the per-instruction cost of the hook.
+extern ExecutionObserverInterface* g_execution_observer;
+
+} // namespace bb::avm2::simulation
