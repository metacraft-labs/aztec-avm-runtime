diff --git a/barretenberg/cpp/src/barretenberg/vm2_reactor/avm_reactor.cpp b/barretenberg/cpp/src/barretenberg/vm2_reactor/avm_reactor.cpp
new file mode 100644
index 0000000000..4a4da152a7
--- /dev/null
+++ b/barretenberg/cpp/src/barretenberg/vm2_reactor/avm_reactor.cpp
@@ -0,0 +1,53 @@
+// SPIKE — the SHAPE OF THE SHIPPABLE ARTEFACT.
+//
+// A wasi "reactor" (no main) exporting a minimal AVM entry point, linking ONLY vm2_sim and its
+// declared dependencies. Nothing from honk/proving/srs/polynomials is reachable from here, so the
+// resulting module measures what a browser would actually download for public execution alone —
+// as opposed to sourcing the AVM from the full ~10 MB barretenberg.wasm.
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "barretenberg/common/wasm_export.hpp"
+#include "barretenberg/serialize/msgpack_impl.hpp"
+#include "barretenberg/vm2/avm_sim_api.hpp"
+#include "barretenberg/vm2/common/avm_io.hpp"
+
+namespace {
+std::vector<uint8_t> g_out;
+}
+
+// Simulate a public tx from a msgpack-encoded AvmProvingInputs blob (hinted DBs: fully
+// self-contained, no host callbacks needed). Returns a pointer to msgpack-encoded
+// TxSimulationResult; length is written through out_len. Buffer valid until the next call.
+WASM_EXPORT const uint8_t* avm_simulate_with_hints(const uint8_t* data, uint32_t len, uint32_t* out_len)
+{
+    using namespace bb::avm2;
+    try {
+        auto inputs = AvmProvingInputs::from(std::vector<uint8_t>(data, data + len));
+        AvmSimAPI api;
+        auto result = api.simulate_with_hinted_dbs(inputs);
+        msgpack::sbuffer buffer;
+        msgpack::pack(buffer, result);
+        g_out.assign(buffer.data(), buffer.data() + buffer.size());
+    } catch (const std::exception& e) {
+        const char* w = e.what();
+        g_out.assign(w, w + strlen(w));
+        *out_len = 0;
+        return reinterpret_cast<const uint8_t*>(g_out.data());
+    }
+    *out_len = static_cast<uint32_t>(g_out.size());
+    return g_out.data();
+}
+
+WASM_EXPORT uint8_t* avm_alloc(uint32_t len)
+{
+    return static_cast<uint8_t*>(malloc(len));
+}
+
+WASM_EXPORT void avm_free(uint8_t* p)
+{
+    free(p);
+}
diff --git a/barretenberg/cpp/src/barretenberg/vm2_spike/CMakeLists.txt b/barretenberg/cpp/src/barretenberg/vm2_spike/CMakeLists.txt
